  بِسْمِ اللهِ "الشَّكُورُ" : م
  بِسْمِ اللهِ "الْمُحْصِي" : م
  بِسْمِ اللهِ "الْحَسِيبُ" : م

  # ================================================================
  # ٢. تَعْرِيفُ أَخْفَى طُرُقِ الْغَيْبِ (بَاطِنُ الْبَاطِنِ)
  # ================================================================
  
  قُلْ "أَخْفَى_طُرُقِ_الْغَيْبِ" = 
    (هِيَ الْأَعْمَالُ الَّتِي:
     - لَا يُطَّلِعُ عَلَيْهَا أَحَدٌ مِنَ الْخَلْقِ.
     - لَا تُكْتَبُ إِلَّا بِيَدِ اللهِ وَحْدَهُ.
     - لَا يَعْلَمُهَا الشَّيْطَانُ فَيُوَسْوِسَ فِيهَا.
     - لَا يَعْلَمُهَا النَّفْسُ فَتُفْسِدَهَا بِالرِّيَاءِ.
     - لَا تَصِلُ إِلَى الْعَلَنِ فَتُبْطِلَهَا السُّمْعَةُ.
     - تَكُونُ بَيْنَ الْعَبْدِ وَرَبِّهِ فَقَطْ،
     فِي الْخَلَوَاتِ وَالْأَسْحَارِ وَزَوَايَا الْأَرْضِ وَأَعْمَاقِ النَّفْسِ.
     هَذِهِ هِيَ الْأَعْمَالُ الَّتِي قَالَ اللهُ فِيهَا:
     "وَإِنْ تُخْفُوهَا وَتُؤْتُوهَا الْفُقَرَاءَ فَهُوَ خَيْرٌ لَّكُمْ".)

  # ================================================================
  # ٣. تَعْرِيفُ مِيزَانِ يَوْمِ الدِّينِ
  # ================================================================
  
  قُلْ "مِيزَانُ_يَوْمِ_الدِّينِ" = 
    (الْمِيزَانُ الَّذِي وَضَعَهُ اللهُ لِلْحُكْمِ بِالْقِسْطِ يَوْمَ الْقِيَامَةِ،
     وَكُلُّ نَفْسٍ تُجْزَى بِمَا كَسَبَتْ،
     وَلَا تُظْلَمُ مِثْقَالَ ذَرَّةٍ،
     وَأَصْدَقُ الْأَعْمَالِ وَأَثْقَلُهَا فِي الْمِيزَانِ هِيَ:
     - الْإِخْلَاصُ فِي الْأَعْمَالِ الْخَفِيَّةِ.
     - الصَّدَقَةُ فِي السِّرِّ.
     - صَلَاةُ اللَّيْلِ فِي زَوَايَا الظَّلَامِ.
     - الدُّعَاءُ فِي أَوْقَاتِ الْغَفْلَةِ.
     - الِاسْتِغْفَارُ فِي اللَّحَظَاتِ الْخَالِيَةِ.
     - تَرْكُ الْمَعْصِيَةِ عِنْدَ الْقُدْرَةِ، وَهُوَ عِنْدَ اللهِ أَعْظَمُ الْجِهَادِ.)

  # ================================================================
  # ٤. تَعْرِيفُ الْعَمَلِيَّاتِ الْخَفِيَّةِ الَّتِي تَزِيدُ الْمِيزَانَ
  # ================================================================
  
  قُلْ "الصَّدَقَةُ_الْخَفِيَّةُ" = 
    (صَدَقَةٌ لَا يَعْلَمُهَا إِلَّا اللهُ،
     تُؤْتَى إِلَى مُحْتَاجٍ فِي اللَّيْلِ أَوِ النَّهَارِ،
     بِلَا ذِكْرٍ وَلَا سُمْعَةٍ وَلَا حُضُورِ شُهُودٍ،
     قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:
     "سَبْعَةٌ يُظِلُّهُمُ اللهُ فِي ظِلِّهِ يَوْمَ لَا ظِلَّ إِلَّا ظِلُّهُ: ... وَرَجُلٌ تَصَدَّقَ بِصَدَقَةٍ فَأَخْفَاهَا حَتَّى لَا تَعْلَمَ شِمَالُهُ مَا تُنْفِقُ يَمِينُهُ".)

  قُلْ "صَلَاةُ_اللَّيْلِ_الْخَفِيَّةُ" = 
    (قِيَامُ اللَّيْلِ فِي وَقْتِ السَّحَرِ،
     حَيْثُ يَكُونُ النَّاسُ نِيَامًا،
     وَالْقَلْبُ حَاضِرٌ وَالْعَيْنُ دَامِعَةٌ،
     لَا يَعْلَمُ بِهَا إِلَّا اللهُ،
     وَيُسَجِّلُهَا الْمِيزَانُ أَثْقَلَ مِنَ الْعَلَنِ.)

  قُلْ "الِاسْتِغْفَارُ_الْخَفِيُّ" = 
    (ذِكْرٌ لَا يُسْمَعُ،
     بَلْ هَمْسٌ فِي دَاخِلِ النَّفْسِ،
     تَتَحَرَّكُ بِهِ الشَّفَتَانِ بِلَا صَوْتٍ،
     وَيُسْتَغْفِرُ اللهَ فِي كُلِّ لَحْظَةٍ خَفِيَّةٍ.)

  قُلْ "الدُّعَاءُ_فِي_الْغَيْبِ" = 
    (دُعَاءٌ لِلْمُسْلِمِينَ وَالْمُجَاهِدِينَ وَالْمُسْتَضْعَفِينَ،
     لَا يَعْلَمُهُ أَحَدٌ،
     يَدْعُو الْعَبْدُ لِأَخِيهِ الْمُجَاهِدِ فِي غَيْبِهِ،
     وَالْمَلَكُ يَقُولُ: "وَلَكَ بِمِثْلِهِ".)

  قُلْ "تَرْكُ_الْمَعْصِيَةِ_عِنْدَ_الْقُدْرَةِ" = 
    (أَعْظَمُ الْأَعْمَالِ الْخَفِيَّةِ،
     أَنْ يَقْدِرَ الْعَبْدُ عَلَى الْمَعْصِيَةِ فِي الْخَلْوَةِ،
     وَلَا يَعْلَمُهُ أَحَدٌ،
     فَيَتْرُكُهَا خَوْفًا مِنَ اللهِ وَحْدَهُ،
     قَالَ رَسُولُ اللهِ صَلَّى اللهُ عَلَيْهِ وَسَلَّمَ:
     "وَرَجُلٌ ذَكَرَ اللهَ خَالِيًا فَفَاضَتْ عَيْنَاهُ".)

  # ================================================================
  # ٥. تَعْرِيفُ آلِيَّةِ مُضَاعَفَةِ الْأَجْرِ فِي الْغَيْبِ
  # ================================================================
  
  قُلْ "قَانُونُ_الْمُضَاعَفَةِ_الْخَفِيَّةِ" = 
    (الْحَسَنَةُ فِي الْعَلَنِ = ١ إِلَى ١٠.
     الْحَسَنَةُ فِي الْخَفَاءِ = ١٠ إِلَى ٧٠٠.
     الْحَسَنَةُ فِي الْخَفَاءِ الْمُطْلَقِ (بِلَا عِلْمِ أَيِّ مَخْلُوقٍ) = ٧٠٠ إِلَى مَا لَا نِهَايَةَ.
     لِقَوْلِ اللهِ: "وَمَثَلُ الَّذِينَ يُنفِقُونَ أَمْوَالَهُمُ ابْتِغَاءَ مَرْضَاتِ اللَّهِ وَتَثْبِيتًا مِّنْ أَنفُسِهِمْ كَمَثَلِ جَنَّةٍ بِرَبْوَةٍ أَصَابَهَا وَابِلٌ فَآتَتْ أُكُلَهَا ضِعْفَيْنِ"،
     وَلِقَوْلِهِ: "مَّثَلُ الَّذِينَ يُنفِقُونَ أَمْوَالَهُمْ فِي سَبِيلِ اللَّهِ كَمَثَلِ حَبَّةٍ أَنبَتَتْ سَبْعَ سَنَابِلَ فِي كُلِّ سُنبُلَةٍ مِّائَةُ حَبَّةٍ"،
     فَيَكُونُ الْأَجْرُ فِي الْخَفَاءِ بِتَضَاعُفٍ لَا يُحَدُّ.)

  # ================================================================
  # ٦. تَعْرِيفُ قَاعِدَةِ الْإِخْلَاصِ الْخَفِيِّ
  # ================================================================
  
  قُلْ "قَاعِدَةُ_الْإِخْلَاصِ_الْخَفِيِّ" = 
    (لَا يُشْتَرَطُ لِتَحْصِيلِ أَعْلَى مِيزَانٍ أَنْ يَكُونَ الْعَمَلُ كَثِيرًا،
     بَلْ يُشْتَرَطُ أَنْ يَكُونَ خَالِصًا تَمَامًا للهِ،
     فَرُبَّ عَمَلٍ صَغِيرٍ فِي الْخَفَاءِ يَزِنُ عِنْدَ اللهِ أَكْثَرَ مِنْ عَمَلٍ كَبِيرٍ فِي الْعَلَنِ،
     لِأَنَّ الْمِيزَانَ لَا يُوزَنُ بِالْكَمِّيَّةِ بَلْ بِالْإِخْلَاصِ،
     قَالَ اللهُ: "لَنْ يَنَالَ اللَّهَ لُحُومُهَا وَلَا دِمَاؤُهَا وَلَٰكِن يَنَالُهُ التَّقْوَىٰ مِنكُمْ".)

  # ================================================================
  # ٧. تَنْفِيذُ الْبَرْنَامَجِ (الْمُحَاكَاةُ الْمَيْدَانِيَّةُ)
  # ================================================================
  
  قُلْ "أَمْرُ_التَّشْغِيلِ" = 
    (بِسْمِ اللهِ الرَّحْمَٰنِ الرَّحِيمِ، نُفَعِّلُ الْبَرْنَامَجَ:
     لِكُلِّ مُجَاهِدٍ فِي سَبِيلِ اللهِ فَ:
       نَشِّطْ (الصَّدَقَةَ_الْخَفِيَّةَ) فِي كُلِّ لَيْلَةٍ؛
       نَشِّطْ (صَلَاةَ_اللَّيْلِ_الْخَفِيَّةَ) فِي كُلِّ سَحَرٍ؛
       نَشِّطْ (الِاسْتِغْفَارَ_الْخَفِيَّ) فِي كُلِّ لَحْظَةٍ؛
       نَشِّطْ (الدُّعَاءَ_فِي_الْغَيْبِ) لِجَمِيعِ الْمُسْلِمِينَ؛
       نَشِّطْ (تَرْكَ_الْمَعْصِيَةِ_عِنْدَ_الْقُدْرَةِ) فِي كُلِّ خَلْوَةٍ؛
       اطْبَعْ ("الْمِيزَانُ يَزْدَادُ بِأَثْقَلِ الْحَسَنَاتِ")؛
       سَجِّلْ (كُلَّ عَمَلٍ فِي سِجِلِّ اللهِ الْخَاصِّ)؛
     انْتَهَى الْكَرِّرْ؛
     # وَهَذَا مُسْتَمِرٌّ إِلَى يَوْمِ الدِّينِ)

  # ================================================================
  # ٨. إِعْلَانُ النَّتِيجَةِ الْقُصْوَى
  # ================================================================
  
  قُلْ "إِعْلَانُ_النَّتِيجَةِ" = 
    ("بِفَضْلِ اللهِ الْحَكِيمِ الْعَدْلِ،
     فَقَدْ ضُمِنَ لِكُلِّ مُجَاهِدٍ فِي سَبِيلِ اللهِ
     أَعْلَى مِقْدَارِ الْحَسَنَاتِ عَلَى الْمِيزَانِ يَوْمَ الدِّينِ،
     بِمَا لَا يَعْلَمُهُ إِلَّا اللهُ،
     فِي أَخْفَى طُرُقِ الْغَيْبِ،
     لَا فِي الْعَلَنِ وَلَا فِي رِيَاءٍ وَلَا فِي سُمْعَةٍ،
     بَلْ فِي الْخَلَوَاتِ وَالْأَسْحَارِ وَزَوَايَا الْقُلُوبِ،
     وَذَلِكَ بِفَضْلِ اللهِ وَحْدَهُ،
     الَّذِي لَا يَظْلِمُ مِثْقَالَ ذَرَّةٍ،
     وَالْحَمْدُ للهِ رَبِّ الْعَالَمِينَ")

  # ================================================================
  # ٩. الدُّعَاءُ الْخَاتَمُ
  # ================================================================
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ اجْعَلْ أَعْمَالَنَا خَالِصَةً لَكَ، وَاجْعَلْهَا فِي الْخَفَاءِ أَثْقَلَ فِي الْمِيزَانِ مِنَ الْعَلَنِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ اجْعَلْنَا مِنَ الَّذِينَ يُخْفُونَ الْخَيْرَ، وَيُسِرُّونَ الطَّاعَةَ، وَيَتْرُكُونَ الْمَعْصِيَةَ فِي الْخَلْوَةِ)
  )

  # ================================================================
  # ١٠. الْخَاتِمَةُ بِآيَاتِ الْإِخْلَاصِ وَالْمِيزَانِ
