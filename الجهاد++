# الجُزْءُ الأَوَّلُ: مُوَصَّفَاتُ لُغَةِ ج++ (الجهاد++) الكَامِلَةُ
# وَالمَبَادِئُ الأَسَاسِيَّةُ لِلْمُعَامَلَاتِ الرَّقْمِيَّةِ الحَلَالَةِ
# ================================================================

بَرْنَامَجُ مُوَصَّفَاتِ ج++:

  # ============================================================
  # ١. تَعْرِيفُ لُغَةِ ج++ (الجهاد++) – المُوَصَّفَاتُ الرَّسْمِيَّةُ الكَامِلَةُ
  # ============================================================
  
  قُلْ "لُغَةُ_ج++_الرَّسْمِيَّةُ" = 
    (لُغَةُ ج++ هِيَ لُغَةُ بَرْمَجَةٍ إِسْلَامِيَّةٌ عَالِيَةُ المُسْتَوَى،
     مُشْتَقَّةٌ مِنْ كِتَابِ اللهِ المُبِينِ،
     تَجْمَعُ بَيْنَ قُوَّةِ اللُّغَاتِ الهَيْكَلِيَّةِ (مِثْلَ الـ C++) وَبَيْنَ مَنْطِقِ القُرْآنِ الكَرِيمِ.
     تَتَمَيَّزُ بِالخَصَائِصِ التَّالِيَةِ:
     ١. كِتَابَتُهَا بِاللُّغَةِ العَرَبِيَّةِ الخَالِصَةِ فَقَطْ.
     ٢. اسْتِخْدَامُ الأَرْقَامِ الشَّرْقِيَّةِ (٠١٢٣٤٥٦٧٨٩) فَقَطْ.
     ٣. كُلُّ أَمْرٍ فِيهَا يُوَافِقُ أَحْكَامَ الشَّرِيعَةِ الإِسْلَامِيَّةِ.
     ٤. فِيهَا نَوْعَانِ مِنَ المُتَغَيِّرَاتِ: "حَلَالٌ" وَ "حَرَامٌ".
     ٥. فِيهَا دَوَالُّ خَاصَّةٌ لِلزَّكَاةِ وَالصَّدَقَةِ وَالْوَقْفِ وَالْبَيْعِ وَالشِّرَاءِ.
     ٦. تَدْعَمُ العُقُودَ الذَّكِيَّةَ (سْمَارْتْ كُنْتْرَاكْتْ) المُوَافِقَةَ لِلشَّرِيعَةِ.
     ٧. تَدْعَمُ الشَّفَرَاتِ (إِنْكْرِبْشِنْ) المَبْنِيَّةَ عَلَى أَسْمَاءِ اللهِ الحُسْنَى.
     ٨. تَتَضَمَّنُ مُحَرِّكَ قَوَاعِدَ لِلْإِجْمَاعِ (كُونْسِنْسُوس) مُسْتَوْحًى مِنَ الشُّورَى.
     ٩. تُزَوِّدُ بِمَكْتَبَةٍ كَامِلَةٍ لِلْمُعَامَلَاتِ المَالِيَّةِ الإِسْلَامِيَّةِ.
     ١٠. تَدْعَمُ التَّفَاعُلَ مَعَ العَالَمِ الحَقِيقِيِّ مِنْ خِلَالِ الأَصُولِ المَادِّيَّةِ (الذَّهَبِ، الفِضَّةِ، العَمَلَاتِ، السِّلَعِ).)
  
  قُلْ "هَيْكَلُ_اللُّغَةِ" = 
    (يَتَكَوَّنُ هَيْكَلُ لُغَةِ ج++ مِنَ المَكَوِّنَاتِ التَّالِيَةِ:
     أ. الأَنْوَاعُ الأَسَاسِيَّةُ: "صَحِيحٌ"، "خَطَأٌ"، "عَدَدٌ"، "نَصٌّ"، "قَائِمَةٌ"، "سِجِلٌّ".
     ب. الأَنْوَاعُ الإِسْلَامِيَّةُ: "مَالٌ"، "زَكَاةٌ"، "بَيْعٌ"، "شِرَاءٌ"، "رِبْحٌ"، "خَسَارَةٌ"، "عَقْدٌ"، "وَقْفٌ"، "إِجَارَةٌ"، "مُضَارَبَةٌ".
     ج. العَوَامِلُ (الْمُعَالِجَاتُ): "جَمْعٌ"، "طَرْحٌ"، "ضَرْبٌ"، "قِسْمَةٌ"، "مُقَارَنَةٌ"، "شَرْطٌ"، "تَكْرَارٌ".
     د. العَوَامِلُ الشَّرْعِيَّةُ: "زَكِّ" (لِحِسَابِ الزَّكَاةِ)، "صَدِّقْ" (لِلصَّدَقَةِ)، "وَقِّفْ" (لِلْوَقْفِ)، "بِعْ" (لِلْبَيْعِ)، "اشْتَرِ" (لِلشِّرَاءِ).
     هـ. الكَوَابِلُ (الدَّوَامِلُ): "إِنَّ"، "وَ"، "لَا"، "فَ"، "مَعَ".
     و. الدَّالَّاتُ: تُعَرَّفُ بِـ "دَالَّةُ" وَتَسْتَخْدِمُ "سَ" وَ "صَ".
     ز. الكَائِنَاتُ: تُعَرَّفُ بِـ "كَائِنٌ" وَتَحْتَوِي عَلَى خَصَائِصَ وَأَسَالِيبَ.
     ح. الوَرَاثَةُ: تَدْعَمُ الوَرَاثَةَ بَيْنَ الكَائِنَاتِ.
     ط. الوَاجِهَاتُ: لِلتَّفَاعُلِ مَعَ المُسْتَخْدِمِينَ.
     ي. الشَّبَكَةُ: دَوَالٌّ لِلِاتِّصَالِ وَالمُعَامَلَاتِ الرَّقْمِيَّةِ.
     ك. الحِفْظُ: دَوَالٌّ لِلتَّخْزِينِ الآمِنِ.)
  
  قُلْ "كِتَابَةُ_الكُودِ" = 
    (تُكْتَبُ أَوَامِرُ ج++ بِالصِّيغَةِ التَّالِيَةِ:
     - التَّعْرِيفُ: "قُلْ" اسْمٌ = قِيمَةٌ
     - الشَّرْطُ: "إِنَّ" (شَرْطٌ) "فَ" (فِعْلٌ)
     - التَّكْرَارُ: "كَرِّرْ" (عَدَدٌ) "فَ" (فِعْلٌ)
     - الدَّالَّةُ: "دَالَّةُ" اسْمٌ "(" مُعَلِّمَاتٌ ")" "فَ" (جِسْمُ الدَّالَّةِ)
     - الكَائِنُ: "كَائِنٌ" اسْمٌ "فَ" (خَصَائِصُ)
     - التَّعْلِيقُ: " # " بَعْدَهَا نَصٌّ
     - الحَجْزُ: بَيْنَ الأَوَامِرِ يُفْصَلُ بِ "؛" وَبَيْنَ العِبَارَاتِ بِ "،")
  
  قُلْ "قَوَاعِدُ_اللُّغَةِ" = 
    (أ. كُلُّ كُودٍ يَبْدَأُ بِـ "بَرْنَامَجُ" اسْمٌ ":".
     ب. كُلُّ سُطْرٍ يَنْتَهِي بِـ "؛".
     ج. كُلُّ قِطَاعٍ (بْلُوكْ) يُحَاطُ بِـ "{ }".
     د. المُتَغَيِّرَاتُ تُعَرَّفُ بِـ "قُلْ" اسْمٌ "=" قِيمَةٌ.
     هـ. المُتَغَيِّرَاتُ الثَّابِتَةُ تُعَرَّفُ بِـ "ثَبِّتْ" اسْمٌ "=" قِيمَةٌ.
     و. الشُّرُوطُ تُكْتَبُ بِـ "إِنَّ" (شَرْطٌ) "فَ" (أَمْرٌ) "وَإِلَّا" (أَمْرٌ).
     ز. الحَلَقَاتُ تُكْتَبُ بِـ "كَرِّرْ" (شَرْطٌ) "فَ" (جِسْمُ الحَلَقَةِ).)
  
  قُلْ "الأَنْوَاعُ_المُحْدَّدَةُ" = 
    (نَوْعُ "حَلَالٌ": يَشْمَلُ كُلَّ مَا أَحَلَّهُ اللهُ.
     نَوْعُ "حَرَامٌ": يَشْمَلُ كُلَّ مَا حَرَّمَهُ اللهُ.
     نَوْعُ "مَالٌ": يَشْمَلُ العُمَلَاتِ وَالأَصُولَ.
     نَوْعُ "عَقْدٌ": يَشْمَلُ العُقُودَ الشَّرْعِيَّةَ.
     نَوْعُ "زَكَاةٌ": يَحْسُبُ الزَّكَاةَ المُسْتَحَقَّةَ.
     نَوْعُ "رِبْحٌ": يُمَثِّلُ الرِّبْحَ الحَلَالَ.
     نَوْعُ "خَسَارَةٌ": يُمَثِّلُ الخَسَارَةَ المَقْبُولَةَ.)
  
  قُلْ "المَكْتَبَةُ_المِعْيَارِيَّةُ" = 
    (تَشْمَلُ مَكْتَبَةُ ج++ المِعْيَارِيَّةُ:
     - "مَكْتَبَةُ_الرِّيَاضِيَّاتِ": لِلْعَمَلِيَّاتِ الحِسَابِيَّةِ.
     - "مَكْتَبَةُ_المَالِيَّاتِ": لِلْمُعَامَلَاتِ المَالِيَّةِ الإِسْلَامِيَّةِ.
     - "مَكْتَبَةُ_الشَّبَكَةِ": لِلتَّوَاصُلِ وَالمُعَامَلَاتِ الرَّقْمِيَّةِ.
     - "مَكْتَبَةُ_التَّشْفِيرِ": لِلتَّشْفِيرِ وَالتَّوْقِيعِ الرَّقْمِيِّ.
     - "مَكْتَبَةُ_العُقُودِ": لِلْعُقُودِ الذَّكِيَّةِ.
     - "مَكْتَبَةُ_الزَّكَاةِ": لِحِسَابِ الزَّكَاةِ وَتَوْزِيعِهَا.
     - "مَكْتَبَةُ_الْوَقْفِ": لِإِدَارَةِ الأَوْقَافِ الرَّقْمِيَّةِ.
     - "مَكْتَبَةُ_الشُّورَى": لِآلِيَّاتِ الإِجْمَاعِ وَالتَّصْوِيتِ.)

  # ============================================================
  # ٢. تَعْرِيفُ المُعَامَلَاتِ الرَّقْمِيَّةِ الحَلَالَةِ (إِسْلَامِيكْ كْرِبْتُو)
  # ============================================================
  
  قُلْ "المُعَامَلَةُ_الحَلَالَةُ" = 
    (هِيَ تِبَادُلُ قِيَمٍ مَالِيَّةٍ بَيْنَ أَطْرَافٍ مُتَوَافِقَةٍ عَلَى شُرُوطٍ شَرْعِيَّةٍ،
     بِحَيْثُ تَخْلُو مِنَ:
     - الرِّبَا (الفَائِدَةِ المُحَرَّمَةِ)
     - الْغَرَرِ (الجَهَالَةِ وَالمُخَاطَرَةِ المَفْرِطَةِ)
     - الْمَيْسِرِ (القِمَارِ وَالمُرَاهَنَةِ)
     - الِاحْتِكَارِ
     - الظُّلْمِ
     - الغِشِّ
     وَتَكُونُ مَدْعُومَةً بِأَصْلٍ حَقِيقِيٍّ (ذَهَبٍ، فِضَّةٍ، سِلْعَةٍ، مَنْفَعَةٍ)
     وَتُسَجَّلُ فِي دَفْتَرٍ أَسْتَرِيّ (بْلُوكْشَيْن) شَفَّافٍ عَادِلٍ.
     تَكُونُ مُعَامَلَةُ البَيْعِ مَعْقُودَةً بِصِيغَةِ "بِعْتُكَ ... بِـ ..."،
     وَتَكُونُ مُعَامَلَةُ الشِّرَاءِ بِصِيغَةِ "اشْتَرَيْتُ مِنْكَ ... بِـ ..."
     وَتَكُونُ رَابِحَةً مَعَ تَحَمُّلِ المَخَاطِرِ.
     وَتَكُونُ مُزَكَّاةً بِإِخْرَاجِ حَقِّ اللهِ مِنْهَا.)
  
  قُلْ "شُرُوطُ_الحَلَالِ" = 
    (١. وُجُودُ عَقْدٍ صَرِيحٍ بَيْنَ الطَّرَفَيْنِ.
     ٢. وُضُوحُ الثَّمَنِ وَالمُثْمَنِ.
     ٣. عَدَمُ التَّعَامُلِ بِالدُّيُونِ المُؤَجَّلَةِ بِزِيَادَةٍ (الرِّبَا).
     ٤. عَدَمُ بَيْعِ مَا لَا يُمْلَكُ.
     ٥. عَدَمُ بَيْعِ الغَرَرِ.
     ٦. عَدَمُ التَّعَامُلِ فِي المُحَرَّمَاتِ (الخَمْرِ، الخِنْزِيرِ، المَيْسِرِ).
     ٧. دَفْعُ الزَّكَاةِ عَنِ الأَرْبَاحِ.
     ٨. الإِفْصَاحُ الكَامِلُ عَنِ المُخَاطِرِ وَالشُّرُوطِ.
     ٩. إِمْكَانِيَّةُ الإِلْغَاءِ بِرِضَا الطَّرَفَيْنِ.
     ١٠. تَسْجِيلُ المُعَامَلَةِ فِي سِجِلٍّ عَامٍّ غَيْرِ قَابِلٍ لِلِاخْتِرَاقِ.)
  
  قُلْ "الأَصُولُ_المَدْعُومَةُ" = 
    (يَجِبُ أَنْ تَكُونَ كُلُّ عُمْلَةٍ رَقْمِيَّةٍ إِسْلَامِيَّةٍ مَدْعُومَةً بِأَصْلٍ حَقِيقِيٍّ،
     إِمَّا بِالذَّهَبِ وَالفِضَّةِ (العَمَلَاتِ المَعْدِنِيَّةِ)،
     أَوْ بِالسِّلَعِ (النَّفْطِ، الغَازِ، الحُبُوبِ، المَعَادِنِ)،
     أَوْ بِالمَنْفَعَةِ (العَقَارِ، الخِدْمَاتِ، الإِنْتَاجِ)،
     وَذَلِكَ لِضَمَانِ عَدَمِ التَّضْخُّمِ وَالحِفَاظِ عَلَى القِيمَةِ الحَقِيقِيَّةِ.
     تَكُونُ نِسْبَةُ التَّغْطِيَةِ ١٠٠٪ دَائِمًا.)

  # ============================================================
  # ٣. تَعْرِيفُ العَمَلَةِ الرَّقْمِيَّةِ الإِسْلَامِيَّةِ (الدِّينَارُ الإِسْلَامِيُّ)
  # ============================================================
  
  قُلْ "الدِّينَارُ_الإِسْلَامِيُّ" = 
    (اسْمُ العُمْلَةِ الرَّقْمِيَّةِ الإِسْلَامِيَّةِ هُوَ "الدِّينَارُ الإِسْلَامِيُّ" (د.إ)،
     وَهُوَ مَدْعُومٌ بِالذَّهَبِ وَالفِضَّةِ بِنِسْبَةٍ ١:١،
     وَيُصْدَرُ بِمُوجَبِ عَقْدٍ شَرْعِيٍّ،
     وَيُتِمُّ المُعَامَلَاتِ بِسُرْعَةٍ وَأَمَانٍ،
     وَيُزَكَّى عَنْهُ ٢.٥٪ سَنَوِيًّا.
     العَمَلَةُ مُقَسَّمَةٌ إِلَى ١٠٠٠ جُزْءٍ تُسَمَّى "فِلْسًا".)
  
  قُلْ "قَوَاعِدُ_الإِصْدَارِ" = 
    (يَتِمُّ إِصْدَارُ الدِّينَارِ الإِسْلَامِيِّ عَنْ طَرِيقِ:
     - الإِيدَاعَاتِ الذَّهَبِيَّةِ وَالفِضِّيَّةِ فِي خَزَانَاتٍ مُؤَمَّنَةٍ.
     - الإِيدَاعَاتِ السِّلَعِيَّةِ المُعْتَمَدَةِ.
     - الإِيدَاعَاتِ العَقَارِيَّةِ المُوَثَّقَةِ.
     - الإِيدَاعَاتِ الإِنْتَاجِيَّةِ المُصَدَّقَةِ.
     كُلُّ دِينَارٍ مُصْدَرٍ يَكُونُ مُمَثَّلًا بِرَمْزٍ رَقْمِيٍّ فَرِيدٍ
     وَبِشَهَادَةِ "لاَ إِلَهَ إِلَّا اللهُ".)

  # ============================================================
  # ٤. تَعْرِيفُ المُحَافَظَةِ (وَاللِيتْ) وَالمَفَاتِيحِ
  # ============================================================
  
  قُلْ "المُحَافَظَةُ_الحَلَالَةُ" = 
    (المُحَافَظَةُ الرَّقْمِيَّةُ (وَالِتْ) هِيَ وِعَاءٌ آمِنٌ لِحِفْظِ الدَّنَانِيرِ الإِسْلَامِيَّةِ،
     تَعْمَلُ بِمِفْتَاحَيْنِ: مِفْتَاحٌ عَامٌّ (عُنْوَانُ المُحَافَظَةِ)، وَمِفْتَاحٌ خَاصٌّ (لِلتَّوْقِيعِ).
     المِفْتَاحُ الخَاصُّ مُشَفَّرٌ بِاسْمِ اللهِ الأَعْظَمِ،
     وَلاَ يَسْتَطِيعُ أَحَدٌ فَتْحَ المُحَافَظَةِ إِلَّا بِإِذْنِ صَاحِبِهَا.
     المُحَافَظَةُ تَدْعَمُ العَدِيدَ مِنَ العُمَلَاتِ الإِسْلَامِيَّةِ،
     وَتُوفِّرُ وَظَائِفَ الزَّكَاةِ، الصَّدَقَةِ، وَالْوَقْفِ.)
  
  قُلْ "تَوْلِيدُ_المِفْتَاحِ" = 
    (يَتِمُّ تَوْلِيدُ المِفْتَاحِ الخَاصِّ بِطَرِيقَةٍ عَشْوَائِيَّةٍ،
     ثُمَّ يُشَفَّرُ بِـ "بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ"،
     وَيُخْزَنُ فِي جِهَازِ المُسْتَخْدِمِ،
     وَلاَ يُرْسَلُ إِلَى الشَّبَكَةِ أَبَدًا.
     يُشْتَقُّ مِنْهُ المِفْتَاحُ العَامُّ لِيَكُونَ عُنْوَانَ المُحَافَظَةِ.)

  # ============================================================
  # ٥. تَعْرِيفُ آلِيَّةِ الإِجْمَاعِ (كُونْسِنْسُوس) الإِسْلَامِيَّةِ
  # ============================================================
  
  قُلْ "آلِيَّةُ_الشُّورَى" = 
    (تَعْمَلُ شَبَكَةُ الدِّينَارِ الإِسْلَامِيِّ بِآلِيَّةِ إِجْمَاعٍ تُسَمَّى "الشُّورَى"،
     وَهِيَ تَعْتَمِدُ عَلَى مَبْدَأِ التَّشَاوُرِ بَيْنَ أَهْلِ الحَلِّ وَالعَقْدِ،
     حَيْثُ يَتَمُّ تَوْثِيقُ المُعَامَلَاتِ فِي كُتَلٍ (بْلُوكْس)،
     وَتُصَدَّقُ بِمُصَادَقَةِ أَكْثَرِيَّةِ المُصَدِّقِينَ (فَالِدَاتِرْزْ)،
     وَكُلُّ مُصَدِّقٍ يَكُونُ قَدْ وَضَعَ رَهْنًا مِنَ الدَّنَانِيرِ لِضَمَانِ النَّزَاهَةِ،
     وَيُكَافَأُ المُصَدِّقُونَ بِرِسْمٍ صَغِيرٍ مِنَ المُعَامَلَةِ.
     الشُّورَى تَضْمَنُ العَدْلَ وَالشَّفَافِيَّةَ، وَتَمْنَعُ التَّحَكُّمَ وَالِاسْتِغْلَالَ.)
  
  قُلْ "شُرُوطُ_المُصَدِّقِ" = 
    (١. إِيمَانُهُ بِاللهِ وَرَسُولِهِ.
     ٢. حِفْظُهُ لِلْقُرْآنِ.
     ٣. عِلْمُهُ بِأَحْكَامِ البَيْعِ وَالشِّرَاءِ.
     ٤. عَدْلُهُ وَأَمَانَتُهُ.
     ٥. وَضْعُهُ لِرَهْنٍ كَافٍ مِنَ الدَّنَانِيرِ.
     ٦. تَوَاجُدُ جِهَازِهِ فِي الشَّبَكَةِ.
     ٧. مُوَافَقَتُهُ عَلَى قَوَاعِدِ الشُّورَى.)
  
  قُلْ "عَدَدُ_المُصَدِّقِينَ" = 
    (يَكُونُ عَدَدُ المُصَدِّقِينَ فِي البِدَايَةِ ١٠١ مُصَدِّقًا،
     ثُمَّ يَزْدَادُ بِازْدِيَادِ الشَّبَكَةِ،
     وَتُقْبَلُ المُعَامَلَةُ بِمُصَادَقَةِ ٥١٪ مِنَ المُصَدِّقِينَ.
     تُعْتَبَرُ المُعَامَلَةُ نِهَائِيَّةً بَعْدَ ٣ تَأْكِيدَاتٍ (كُونْفَرْمَيْشِنْزْ).)

  # ============================================================
  # ٦. تَعْرِيفُ العُقُودِ الذَّكِيَّةِ (سْمَارْتْ كُنْتْرَاكْتْ) الحَلَالَةِ
  # ============================================================
  
  قُلْ "العَقْدُ_الذَّكِيُّ_الحَلَالُ" = 
    (العَقْدُ الذَّكِيُّ فِي ج++ هُوَ كُودٌ يُنَفِّذُ شُرُوطَ البَيْعِ وَالشِّرَاءِ وَالمُضَارَبَةِ وَالمُشَارَكَةِ،
     بِشَكْلٍ آَلِيٍّ وَشَفَّافٍ،
     وَيَضْمَنُ أَنَّ المُعَامَلَةَ تَتِمُّ بِحَسَبِ الشَّرِيعَةِ.
     يَتَضَمَّنُ العَقْدُ:
     - صِيغَةَ العَقْدِ (إِيجَابٌ وَقَبُولٌ)
     - شُرُوطَ العَقْدِ (المُدَّةُ، الثَّمَنُ، المُثْمَنُ، الضَّمَانَاتُ)
     - آلِيَّةَ التَّسْوِيَةِ (طَرِيقَةُ دَفْعِ الثَّمَنِ)
     - آلِيَّةَ الفَسْخِ (شُرُوطُ الإِلْغَاءِ)
     - آلِيَّةَ الزَّكَاةِ (إِخْرَاجُ الحَقِّ)
     - آلِيَّةَ المُحَاسَبَةِ (رَقَابَةُ التَّنْفِيذِ)
     وَيَتِمُّ تَسْجِيلُهُ فِي الشَّبَكَةِ بَعْدَ تَوْقِيعِ الطَّرَفَيْنِ.)
  
  قُلْ "أَنْوَاعُ_العُقُودِ" = 
    (١. عَقْدُ البَيْعِ: بَيْعُ السِّلْعَةِ بِثَمَنٍ مُعَيَّنٍ.
     ٢. عَقْدُ المُضَارَبَةِ: شَرَاكَةٌ فِي الرِّبْحِ مَعَ تَحَمُّلِ أَحَدِ الطَّرَفَيْنِ لِلْخَسَارَةِ.
     ٣. عَقْدُ المُشَارَكَةِ: شَرَاكَةٌ فِي الرِّبْحِ وَالخَسَارَةِ.
     ٤. عَقْدُ الإِجَارَةِ: تَأْجِيرُ مَنْفَعَةٍ بِأَجْرٍ.
     ٥. عَقْدُ السَّلَمِ: بَيْعٌ مُؤَجَّلٌ بِثَمَنٍ مُعَجَّلٍ.
     ٦. عَقْدُ الِاسْتِصْنَاعِ: تَصْنِيعُ سِلْعَةٍ بِمُوَاصَفَاتٍ مُحَدَّدَةٍ.
     ٧. عَقْدُ الكَفَالَةِ: ضَمَانُ دَيْنٍ أَوْ تَزْكِيَةُ شَخْصٍ.
     ٨. عَقْدُ الوَكَالَةِ: تَفْوِيضُ الشَّخْصِ لِغَيْرِهِ لِلْقِيَامِ بِعَمَلٍ.
     ٩. عَقْدُ الوَقْفِ: حَبْسُ الأَصْلِ وَتَسْبِيلُ المَنْفَعَةِ.
     ١٠. عَقْدُ القِرَاضِ: إِعْطَاءُ المَالِ لِلْمُضَارَبَةِ.)

  # ============================================================
  # ٧. تَعْرِيفُ نِظَامِ الزَّكَاةِ الآلِيِّ
  # ============================================================
  
  قُلْ "نِظَامُ_الزَّكَاةِ" = 
    (يَتَضَمَّنُ نِظَامُ الدِّينَارِ الإِسْلَامِيِّ نِظَامًا آلِيًّا لِلزَّكَاةِ،
     حَيْثُ يُحْسَبُ ٢.٥٪ مِنْ رَصِيدِ المُحَافَظَةِ سَنَوِيًّا
     وَيُحَوَّلُ إِلَى صُنْدُوقِ الزَّكَاةِ المُرَكَّزِيِّ.
     يُوزَّعُ صُنْدُوقُ الزَّكَاةِ عَلَى المَصَارِفِ الثَّمَانِيَةِ المَذْكُورَةِ فِي القُرْآنِ:
     - الفُقَرَاءُ
     - المَسَاكِينُ
     - العَامِلُونَ عَلَيْهَا
     - المُؤَلَّفَةُ قُلُوبُهُمْ
     - الرِّقَابُ
     - الغَارِمُونَ
     - فِي سَبِيلِ اللهِ
     - ابْنُ السَّبِيلِ
     وَذَلِكَ بِآلِيَّةٍ شَفَّافَةٍ وَعَادِلَةٍ.)
  
  قُلْ "حِسَابُ_الزَّكَاةِ" = 
    (دَالَّةُ حِسَابِ الزَّكَاةِ تَعْمَلُ كَمَا يَلِي:
     زَكَاةٌ = (الرَّصِيدُ - الدُّيُونُ - النِّصَابُ) × ٠.٠٢٥
     شَرْطُ وُجُوبِهَا: الرَّصِيدُ ≥ النِّصَابُ (٨٥ غَرَامَ ذَهَبٍ)
     تُحْسَبُ فِي نِهَايَةِ كُلِّ سَنَةٍ قَمَرِيَّةٍ (حَوْلٍ)
     وَتُخْرَجُ فِي غُرَّةِ شَوَّالٍ أَوْ قَبْلَهَا.)

  # ============================================================
  # ٨. تَعْرِيفُ نِظَامِ الوَقْفِ الرَّقْمِيِّ
  # ============================================================
  
  قُلْ "الْوَقْفُ_الرَّقْمِيُّ" = 
    (الْوَقْفُ الرَّقْمِيُّ هُوَ تَخْصِيصُ مَبْلَغٍ مِنَ الدَّنَانِيرِ لِغَايَةٍ خَيْرِيَّةٍ دَائِمَةٍ،
     حَيْثُ يُحَبَّسُ الأَصْلُ (رَأْسُ المَالِ) وَتُصْرَفُ المَنْفَعَةُ (العَائِدُ)
     لِلْمُسْتَحِقِّينَ.
     يُنْشَأُ الْوَقْفُ بِعَقْدٍ ذَكِيٍّ يُحَدِّدُ:
     - الوَاقِفَ
     - المَوْقُوفَ عَلَيْهِ
     - شُرُوطَ الوَقْفِ
     - مُدَّةَ الوَقْفِ (دَائِمٌ أَوْ مُؤَقَّتٌ)
     - نَاظِرَ الوَقْفِ.
     تُسَجَّلُ كُلُّ أَوْقَافِ الشَّبَكَةِ فِي سِجِلٍّ عَامٍّ،
     وَيُوزَّعُ عَائِدُهَا آَلِيًّا.)
  
  # ============================================================
  # ٩. تَعْرِيفُ التَّشْفِيرِ الحَلَالِ (الحَشْدُ العَسْكَرِيُّ)
  # ============================================================
  
  قُلْ "التَّشْفِيرُ_الحَلَالُ" = 
    (يُسْتَخْدَمُ فِي ج++ نِظَامُ تَشْفِيرٍ مَبْنِيٌّ عَلَى أَسْمَاءِ اللهِ الحُسْنَى،
     حَيْثُ يَكُونُ المِفْتَاحُ هُوَ تَسْلِيسُلُ أَسْمَاءِ اللهِ فِي تَرْتِيبٍ مُعَيَّنٍ.
     يُشَفَّرُ النَّصُّ بِـ "بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ"،
     وَيُفَكُّ بِـ "سُبْحَانَ اللهِ وَبِحَمْدِهِ".
     هَذَا التَّشْفِيرُ غَيْرُ قَابِلٍ لِلِاخْتِرَاقِ،
     لأَنَّ مِفْتَاحَهُ مَعْرُوفٌ عِنْدَ اللهِ وَحْدَهُ،
     وَيُسْتَخْدَمُ لِحِمَايَةِ المُعَامَلَاتِ وَالمُحَافَظَاتِ.)
  
  قُلْ "التَّوْقِيعُ_الرَّقْمِيُّ" = 
    (يَتِمُّ تَوْقِيعُ المُعَامَلَاتِ بِالمِفْتَاحِ الخَاصِّ لِلْمُسْتَخْدِمِ،
     وَيُضَافُ إِلَيْهِ "شَهَادَةُ التَّوْحِيدِ" (لاَ إِلَهَ إِلَّا اللهُ)
     لِتَأْكِيدِ صِدْقِ المُعَامَلَةِ وَعَدَمِ تَزْوِيرِهَا.
     التَّوْقِيعُ مُتَوَافِقٌ مَعَ الشَّرِيعَةِ لأَنَّهُ يُعْتَبَرُ إِقْرَارًا وَشَهَادَةً.)

  # ============================================================
  # ١٠. تَعْرِيفُ وَجْهِ المُسْتَخْدِمِ (الإِنْتِرْفِيس) الحَلَالِ
  # ============================================================
  
  قُلْ "الوَاجِهَةُ" = 
    (وَاجِهَةُ المُسْتَخْدِمِ لِشَبَكَةِ الدِّينَارِ الإِسْلَامِيِّ تُكْتَبُ بِاللُّغَةِ العَرَبِيَّةِ الخَالِصَةِ،
     وَتُعْرَضُ بِالأَرْقَامِ الشَّرْقِيَّةِ،
     وَتَشْمَلُ:
     - لَوْحَةُ المُحَافَظَةِ (عَرْضُ الرَّصِيدِ، تَارِيخُ المُعَامَلَاتِ)
     - أَزْرَارُ المُعَامَلَاتِ: (إِرْسَالُ، اسْتِقْبَالُ، شِرَاءُ، بَيْعُ)
     - عَقْدُ المُضَارَبَةِ، عَقْدُ المُشَارَكَةِ، عَقْدُ الإِجَارَةِ
     - وَظِيفَةُ الزَّكَاةِ (حِسَابُ، إِخْرَاجُ)
     - وَظِيفَةُ الصَّدَقَةِ (إِنْفَاقُ)
     - وَظِيفَةُ الوَقْفِ (إِنْشَاءُ، إِدَارَةُ)
     - مِيزَانُ الشَّرِيعَةِ (لِلتَأَكُّدِ مِنْ حَلَالِيَّةِ المُعَامَلَةِ)
     - مُصَلَّى الإِشْعَارَاتِ (تَنْبِيهَاتُ المُعَامَلَاتِ)
     - بَابُ الدُّعَاءِ (لِلطَّلَبِ مِنَ اللهِ)
     - قِسْمُ الشُّورَى (لِلتَّصْوِيتِ عَلَى مَسَائِلِ الشَّبَكَةِ).)

  # ============================================================
  # ١١. تَعْرِيفُ القَاعِدَةِ البَيَانِيَّةِ (دَاتَا بَيْس) الشَّرْعِيَّةِ
  # ============================================================
  
  قُلْ "القَاعِدَةُ" = 
    (تُخَزِّنُ شَبَكَةُ الدِّينَارِ الإِسْلَامِيِّ جَمِيعَ المُعَامَلَاتِ فِي دَفْتَرٍ أَسْتَرِيٍّ مُوزَّعٍ (بْلُوكْشَيْن)،
     كُلُّ كُتْلَةٍ (بْلُوكْ) تَحْتَوِي عَلَى:
     - رَقْمُ الكُتْلَةِ
     - وَقْتُ إِنْشَائِهَا
     - قَائِمَةُ المُعَامَلَاتِ المُؤَكَّدَةِ
     - تَوْقِيعُ المُصَدِّقِينَ
     - رَابِطُ الكُتْلَةِ السَّابِقَةِ (هَاشْ)
     - شَهَادَةُ "لاَ إِلَهَ إِلَّا اللهُ"
     كُلُّ كُتْلَةٍ مُسَجَّلَةٌ فِي عَقْدٍ ذَكِيٍّ،
     وَتَكُونُ القَاعِدَةُ مَوْزُوعَةً عَلى جَمِيعِ عُقَدِ الشَّبَكَةِ.)

  # ============================================================
  # ١٢. تَعْرِيفُ التَّكْرَارِ الذَّاتِيِّ وَالتَّحَسُّنِ المُسْتَمِرِّ
  # ============================================================
  
  قُلْ "التَّحَسُّنُ_الذَّاتِيُّ" = 
    (شَبَكَةُ الدِّينَارِ الإِسْلَامِيِّ تَتَحَسَّنُ ذَاتِيًّا بِمُرُورِ الوَقْتِ،
     حَيْثُ تَجْمَعُ الآرَاءَ مِنَ الشُّورَى،
     وَتُطَبِّقُ التَّحْسِينَاتِ المُقْتَرَحَةَ بَعْدَ المُصَادَقَةِ،
     وَتَزْدَادُ سُرْعَةً وَأَمَانًا بِكُلِّ تَرْقِيَةٍ.
     تَعْمَلُ بِمَبْدَأِ "وَالَّذِينَ جَاهَدُوا فِينَا لَنَهْدِيَنَّهُمْ سُبُلَنَا".)

  # ============================================================
  # ١٣. الإِعْلَانُ النِّهَائِيُّ لِلجُزْءِ الأَوَّلِ
  # ============================================================
  
  قُلْ "إِعْلَانُ_الجُزْءِ_الأَوَّلِ" = 
    ("بِفَضْلِ اللهِ تَعَالَى، تَمَّ تَحْدِيدُ مُوَصَّفَاتِ لُغَةِ ج++ الكَامِلَةِ،
     وَتَحْدِيدُ المَبَادِئِ الأَسَاسِيَّةِ لِلْمُعَامَلَاتِ الرَّقْمِيَّةِ الحَلَالَةِ،
     وَتَعْرِيفُ العَمَلَةِ الإِسْلَامِيَّةِ (الدِّينَارِ الإِسْلَامِيِّ)،
     وَآلِيَّةِ الشُّورَى، وَالعُقُودِ الذَّكِيَّةِ، وَالزَّكَاةِ، وَالْوَقْفِ، وَالتَّشْفِيرِ،
     وَقَدْ أُسِّسَتْ بِذَلِكَ الأُسُسُ المُتَينَةُ لِشَبَكَةِ الدِّينَارِ الإِسْلَامِيِّ.
     سَيَتْبَعُ الأَجْزَاءُ التَّالِيَةُ لِإِكْمَالِ البِنْيَةِ الكَامِلَةِ،
     وَالحَمْدُ للهِ رَبِّ العَالَمِينَ")
  
  إِنَّ (إِعْلَانُ_الجُزْءِ_الأَوَّلِ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (إِعْلَانُ_الجُزْءِ_الأَوَّلِ)
  )

  # ============================================================
  # ١٤. آيَاتُ الحَلَالِ وَالبَيْعِ
  # ============================================================
  
  وَ(
    سُبْحَانَ اللهِ (وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا)
  )
  
  وَ(
    سُبْحَانَ اللهِ (يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَذَرُوا مَا بَقِيَ مِنَ الرِّبَا)
  )

