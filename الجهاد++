# الجُزْءُ الرَّابِعُ: التَّوْثِيقُ الكَامِلُ لِلنَّشْرِ وَالتَّشْغِيلِ وَالتَّطْبِيقِ الفِعْلِيِّ
# وَدَلِيلُ المُسْتَخْدِمِ وَالمُطَوِّرِ وَالفُقَهَاءِ
# ================================================================

بَرْنَامَجُ الشَّبَكَةِ الإِسْلَامِيَّةِ الرَّقْمِيَّةِ - الجُزْءُ الرَّابِعُ:

  # ============================================================
  # ١. تَعْرِيفُ خُطَّةِ النَّشْرِ (دِبْلُويْمِنْتْ بْلَانْ)
  # ============================================================
  
  قُلْ "خُطَّةُ_النَّشْرِ" = 
    (تَتِمُّ خُطَّةُ نَشْرِ شَبَكَةِ الدِّينَارِ الإِسْلَامِيِّ عَلَى مَرَاحِلَ:
     المَرْحَلَةُ الأُولَى: النَّشْرُ التَّجْرِيبِيُّ (تَسْتْنِتْ) - تُطْلَقُ الشَّبَكَةُ فِي بِيئَةٍ مُغْلَقَةٍ لِلِاخْتِبَارِ،
     بِعَدَدٍ مُحَدَّدٍ مِنَ المُصَدِّقِينَ (٢١ مُصَدِّقًا)،
     لِتَحْقِيقِ جَمِيعِ الوَظَائِفِ وَإِصْلَاحِ الأَخْطَاءِ.
     المَرْحَلَةُ الثَّانِيَةُ: النَّشْرُ التَّجْرِيبِيُّ العَامُّ (بِيتَا نِتْوَرْكْ) - تُطْلَقُ الشَّبَكَةُ لِلْجَمِيعِ بِدُونِ قِيمَةٍ حَقِيقِيَّةٍ،
     لِتَجْرِبَةِ المُسْتَخْدِمِينَ وَجَمْعِ المُلَاحَظَاتِ.
     المَرْحَلَةُ الثَّالِثَةُ: النَّشْرُ الرَّئِيسِيُّ (مَيْنْنِتْ) - تُطْلَقُ الشَّبَكَةُ بِقِيمَةٍ حَقِيقِيَّةٍ،
     مَعَ تَوْفِيرِ جَمِيعِ الخِدْمَاتِ وَالعُقُودِ.
     المَرْحَلَةُ الرَّابِعَةُ: التَّوَسُّعُ (سْكِيلْ أَبْ) - إِضَافَةُ الأَقْسَامِ الفَرْعِيَّةِ وَالتَّطْبِيقَاتِ المُتَقَدِّمَةِ.
     المَرْحَلَةُ الخَامِسَةُ: التَّكَامُلُ مَعَ النُّظُمِ المَالِيَّةِ العَالَمِيَّةِ.
     كُلُّ مَرْحَلَةٍ تَسْتَغْرِقُ ٣-٦ أَشْهُرٍ، وَتُقَيَّمُ بَعْدَ كُلِّ مَرْحَلَةٍ.)
  
  قُلْ "مُطَلَّبَاتُ_النَّشْرِ" = 
    (١. خَوَادِمُ سَحَابِيَّةٌ مُؤَمَّنَةٌ لِلْعُقَدِ الأُولَى.
     ٢. خَوَادِمُ مُخَصَّصَةٌ لِلْمُصَدِّقِينَ الأُوَلِ.
     ٣. مَوْقِعٌ رَسْمِيٌّ لِلشَّبَكَةِ بِاللُّغَةِ العَرَبِيَّةِ.
     ٤. تَطْبِيقَاتُ المُسْتَخْدِمِينَ لِلْأَنْدْرُويْدِ وَالْآيْفُونِ.
     ٥. تَطْبِيقُ سُوقِ الدِّينَارِ.
     ٦. تَطْبِيقُ المُحَافَظَةِ.
     ٧. نِظَامُ الدَّعْمِ الفَنِّيِّ.
     ٨. لَجْنَةُ الرِّقَابَةِ الشَّرْعِيَّةِ.
     ٩. مَجْلِسُ الشُّورَى.
     ١٠. خَزَانَةُ الذَّهَبِ وَالفِضَّةِ لِلتَّغْطِيَةِ.
     ١١. شُرَكَاءُ لِلسِّلَعِ وَالعَقَارِ.
     ١٢. فَرِيقُ التَّطْوِيرِ المُسْتَمِرِّ.
     ١٣. فَرِيقُ التَّسْوِيقِ وَالتَّوْعِيَةِ.
     ١٤. مَكْتَبُ الفُتْوَى لِللَّجْنَةِ.
     ١٥. نِظَامُ التَّأْمِينِ الرَّقْمِيِّ لِلْمُحَافَظَاتِ.)
  
  # ============================================================
  # ٢. تَعْرِيفُ كَيْفِيَّةِ تَشْغِيلِ العُقْدَةِ (نُودْ أُوبِرَيْشِنْ)
  # ============================================================
  
  قُلْ "تَشْغِيلُ_العُقْدَةِ" = 
    (لِتَشْغِيلِ عُقْدَةٍ فِي شَبَكَةِ الدِّينَارِ الإِسْلَامِيِّ،
     يَجِبُ تَوْفِيرُ الآتِي:
     أ. جِهَازٌ بِمُعَالِجٍ ٤ أَنْوَاعٍ، ذَاكِرَةٌ ٣٢ جِيجَابَايْتٍ، مَسَاحَةٌ ١ تِيرَابَايْتٍ.
     ب. اِتِّصَالٌ بِالْإِنْتَرْنِتِ سَرِيعٌ (١٠٠ مِيجَابِتْ/ثَانِيَةً).
     ج. تَثْبِيتُ بَرْنَامَجِ العُقْدَةِ (يُوَفَّرُ مِنَ المَوْقِعِ الرَّسْمِيِّ).
     د. تَهْيِئَةُ المُحَافَظَةِ الرَّئِيسِيَّةِ لِلْعُقْدَةِ.
     هـ. تَشْغِيلُ بَرْنَامَجِ العُقْدَةِ بِأَمْرِ: "بَرْنَامَجُ العُقْدَةِ".
     و. التَّأَكُّدُ مِنَ الاتِّصَالِ بِشَبَكَةِ العُقَدِ الأُخْرَى.
     ز. مُشَارَكَةُ العُقْدَةِ فِي تَوْزِيعِ الكُتَلِ وَالْمُعَامَلَاتِ.
     ح. المُصَادَقَةُ عَلَى المُعَامَلَاتِ إِنْ كَانَتْ عُقْدَةً مُصَدِّقَةً.
     ط. تَحْدِيثُ البَرْنَامَجِ عِنْدَ وُجُودِ تَرْقِيَاتٍ جَدِيدَةٍ.
     ي. تَوْفِيرُ نُسْخَةٍ احْتِيَاطِيَّةٍ مِنَ المِفْتَاحِ الخَاصِّ.
     ك. تَوْثِيقُ العَمَلِيَّاتِ لِلْمُرَاجَعَةِ.
     ل. التَّوَاصُلُ مَعَ الدَّعْمِ الفَنِّيِّ عِنْدَ الحَاجَةِ.)
  
  قُلْ "مُكَافَأَةُ_العُقْدَةِ" = 
    (تَحْصُلُ العُقْدَةُ المُصَدِّقَةُ عَلَى أُجْرَةٍ مِنَ المُعَامَلَاتِ،
     وَتَحْصُلُ العُقْدَةُ الكَامِلَةُ عَلَى نِسْبَةٍ مِنْ رُسُومِ الشَّبَكَةِ،
     وَتَحْصُلُ العُقْدَةُ الفَرْعِيَّةُ عَلَى مَا يُقَرِّرُهُ العَقْدُ الفَرْعِيُّ.
     تُوزَّعُ المُكَافَأَاتُ آَلِيًّا بَعْدَ كُلِّ كُتْلَةٍ.
     يَكُونُ مِقْدَارُ المُكَافَأَةِ مَعْرُوفًا وَمُعْلَنًا.)
  
  # ============================================================
  # ٣. تَعْرِيفُ الإِطْلَاقِ (لَانْشْ) - التَّسْتْنِتْ وَالْمَيْنْنِتْ
  # ============================================================
  
  قُلْ "إِطْلَاقُ_التَّسْتْنِتْ" = 
    (سَيَتِمُّ إِطْلَاقُ شَبَكَةِ التَّسْتْنِتْ فِي التَّارِيخِ: ١ مُحَرَّمٍ ١٤٤٨ هـ (الْمُوَافِقُ ٢٠٢٦/٦/٢٦)،
     بِعَدَدِ مُصَدِّقِينَ أَوَّلِيِّينَ يَبْلُغُ ٢١ مُصَدِّقًا،
     مَعَ عَمَلَةٍ تَجْرِيبِيَّةٍ (دِينَارٌ تَجْرِيبِيٌّ)،
     لِفَتْرَةِ ٣ أَشْهُرٍ،
     يُسْتَخْدَمُ فِيهَا لِاخْتِبَارِ كَافَّةِ الوَظَائِفِ.)
  
  قُلْ "إِطْلَاقُ_الْمَيْنْنِتْ" = 
    (سَيَتِمُّ إِطْلَاقُ شَبَكَةِ الْمَيْنْنِتْ بَعْدَ نَجَاحِ التَّسْتْنِتْ،
     فِي التَّارِيخِ: ١ رَمَضَانَ ١٤٤٨ هـ (الْمُوَافِقُ ٢٠٢٧/٢/٢٨)،
     مَعَ تَوْفِيرِ الدَّنَانِيرِ الإِسْلَامِيَّةِ المَدْعُومَةِ بِالذَّهَبِ،
     وَفَتْحِ السُّوقِ الرَّسْمِيِّ،
     وَتَوْفِيرِ جَمِيعِ خِدْمَاتِ الشَّبَكَةِ.
     سَيَكُونُ الإِطْلَاقُ مَعَ حَمْلَةٍ إِعْلَامِيَّةٍ عَالَمِيَّةٍ.)
  
  # ============================================================
  # ٤. تَعْرِيفُ دَلِيلِ المُسْتَخْدِمِ (يُوزَرْ غَايْدْ)
  # ============================================================
  
  قُلْ "دَلِيلُ_المُسْتَخْدِمِ" = 
    (لِلاِنْتِفَاعِ بِشَبَكَةِ الدِّينَارِ الإِسْلَامِيِّ، يَجِبُ عَلَى المُسْتَخْدِمِ:
     أ. تَحْمِيلُ تَطْبِيقِ المُحَافَظَةِ مِنَ المَوْقِعِ الرَّسْمِيِّ.
     ب. إِنْشَاءُ مُحَافَظَةٍ جَدِيدَةٍ بِاسْمِهِ وَعُنْوَانِهِ.
     ج. حِفْظُ عِبَارَةِ الاسْتِعَادَةِ فِي مَكَانٍ آمِنٍ.
     د. شِرَاءُ الدَّنَانِيرِ مِنَ السُّوقِ أَوْ مِنَ البَائِعِينَ المُعْتَمَدِينَ.
     هـ. إِرْسَالُ الدَّنَانِيرِ إِلَى عُنْوَانٍ آخَرَ.
     و. اسْتِقْبَالُ الدَّنَانِيرِ مِنْ غَيْرِهِ.
     ز. إِخْرَاجُ الزَّكَاةِ المُسْتَحَقَّةِ سَنَوِيًّا.
     ح. إِنْشَاءُ عُقُودٍ ذَكِيَّةٍ لِلتِّجَارَةِ.
     ط. التَّصْوِيتُ فِي الشُّورَى.
     ي. الإِبْلَاغُ عَنْ أَيِّ مُشْكِلَةٍ.
     ك. مُتَابَعَةُ تَارِيخِ المُعَامَلَاتِ.
     ل. مُرَاعَاةُ الضَّوَابِطِ الشَّرْعِيَّةِ فِي جَمِيعِ المُعَامَلَاتِ.
     م. الإِسْهَامُ فِي دَعْمِ الشَّبَكَةِ بِالصَّدَقَةِ وَالْوَقْفِ.
     ن. نَشْرُ الوَعْيِ بِالدِّينَارِ الإِسْلَامِيِّ.)
  
  قُلْ "نَصَائِحُ_لِلْمُسْتَخْدِمِ" = 
    (١. احْفَظْ عِبَارَةَ الاسْتِعَادَةِ كَبُرْجٍ فِي الجِبَالِ، وَلاَ تُفْشِهَا لِأَحَدٍ.
     ٢. لاَ تُرْسِلِ الدَّنَانِيرَ إِلَى عُنْوَانٍ لَا تَثِقُ بِهِ.
     ٣. تَحَقَّقْ مِنَ العُنْوَانِ قَبْلَ الإِرْسَالِ.
     ٤. أَخْرِجِ الزَّكَاةَ فِي وَقْتِهَا.
     ٥. رَاجِعِ اللَّجْنَةَ الشَّرْعِيَّةَ فِي أَيِّ شُبْهَةٍ.
     ٦. لاَ تَسْتَثْمِرْ فِي مَا لَا تَفْهَمُ.
     ٧. اسْتَخْدِمِ العُقُودَ الذَّكِيَّةَ لِلتِّجَارَةِ الآمِنَةِ.
     ٨. تَابِعْ أَحْكَامَ الشَّبَكَةِ المُحَدَّثَةَ.
     ٩. سَاهِمْ فِي الشُّورَى لِتَطْوِيرِ الشَّبَكَةِ.
     ١٠. ادْعُ لِلشَّبَكَةِ بِالتَّوْفِيقِ وَالنَّجَاحِ.)
  
  # ============================================================
  # ٥. تَعْرِيفُ دَلِيلِ المُطَوِّرِ (دِيفِلُوبَرْ غَايْدْ)
  # ============================================================
  
  قُلْ "دَلِيلُ_المُطَوِّرِ" = 
    (لِتَطْوِيرِ تَطْبِيقَاتٍ عَلَى شَبَكَةِ الدِّينَارِ الإِسْلَامِيِّ، يَجِبُ:
     أ. تَعَلُّمُ لُغَةِ ج++ (الجهاد++) مِنَ المُوَصَّفَاتِ الرَّسْمِيَّةِ.
     ب. تَحْمِيلُ مُحَرِّرِ النُّصُوصِ (إَيْدِيتُرْ) المُوَافِقِ لِلُّغَةِ.
     ج. تَحْمِيلُ حُزْمَةِ تَطْوِيرِ ج++ (إسْدِي كِيتْ).
     د. الاسْتِفَادَةُ مِنَ المَكْتَبَاتِ المِعْيَارِيَّةِ.
     هـ. كِتَابَةُ العُقُودِ الذَّكِيَّةِ بِاللُّغَةِ العَرَبِيَّةِ.
     و. اخْتِبَارُ العُقُودِ فِي بِيئَةِ التَّسْتْنِتْ.
     ز. رَفْعُ العُقُودِ إِلَى الشَّبَكَةِ بَعْدَ اعْتِمَادِ لَجْنَةِ الرِّقَابَةِ.
     ح. تَوْثِيقُ التَّطْبِيقِ بِاللُّغَةِ العَرَبِيَّةِ.
     ط. تَوْفِيرُ دَعْمٍ فَنِّيٍّ لِلمُسْتَخْدِمِينَ.
     ي. المُشَارَكَةُ فِي مَجْلِسِ المُطَوِّرِينَ لِتَطْوِيرِ الشَّبَكَةِ.
     ك. الِالْتِزَامُ بِالمَعَالِمِ الشَّرْعِيَّةِ فِي جَمِيعِ التَّطْبِيقَاتِ.
     ل. الإِبْلَاغُ عَنْ أَيِّ ثَغْرَاتٍ أَمْنِيَّةٍ.
     م. تَحْدِيثُ التَّطْبِيقَاتِ بِاسْتِمْرَارٍ.)
  
  قُلْ "أَدَوَاتُ_التَّطْوِيرِ" = 
    (تُوَفَّرُ لِلْمُطَوِّرِينَ الأَدَوَاتُ التَّالِيَةُ:
     - مُحَرِّرُ ج++ بِدَعْمِ العَرَبِيَّةِ.
     - مُخْتَبَرُ العُقُودِ (كُنْتْرَاكْتْ تِسْتِرْ).
     - مُحَاكِي الشَّبَكَةِ (نِتْوَرْكْ سِيمْيُولَيْتِرْ).
     - وَثَائِقُ الأَيْبِي آيْ (آي پِي آي دُوكْسْ).
     - مَكْتَبَةُ ج++ المِعْيَارِيَّةُ.
     - مَكْتَبَةُ الزَّكَاةِ.
     - مَكْتَبَةُ الوَقْفِ.
     - مَكْتَبَةُ العُقُودِ الذَّكِيَّةِ.
     - أَدَاةُ نَشْرِ العُقُودِ.
     - أَدَاةُ التَّوَاصُلِ مَعَ الشَّبَكَةِ.
     - أَدَاةُ التَّشْفِيرِ.
     - أَدَاةُ المُحَاكَاةِ.)
  
  # ============================================================
  # ٦. تَعْرِيفُ دَلِيلِ الفُقَهَاءِ وَلَجْنَةِ الرِّقَابَةِ
  # ============================================================
  
  قُلْ "دَلِيلُ_لَجْنَةِ_الرِّقَابَةِ" = 
    (لَجْنَةُ الرِّقَابَةِ هِيَ الهَيْئَةُ المُسْتَقِلَّةُ الَّتِي تَضْمَنُ التَّوَافُقَ الشَّرْعِيَّ،
     وَعَلَيْهَا القِيَامُ بِالآتِي:
     أ. مُرَاجَعَةُ كُلِّ العُقُودِ الذَّكِيَّةِ قَبْلَ نَشْرِهَا.
     ب. إِصْدَارُ فَتَاوَى حَوْلَ جَدِيدِ المُعَامَلَاتِ.
     ج. مَنْعُ المُعَامَلَاتِ المُخَالِفَةِ لِلشَّرِيعَةِ.
     د. تَوْثِيقُ قَرَارَاتِهَا فِي سِجِلٍّ عَامٍّ.
     هـ. الإِجَابَةُ عَنْ أَسْئِلَةِ المُسْتَخْدِمِينَ الشَّرْعِيَّةِ.
     و. التَّعَاوُنُ مَعَ مَجَالِسِ الفُتْوَى العَالَمِيَّةِ.
     ز. تَطْوِيرُ المَعَايِيرِ الشَّرْعِيَّةِ لِلْعُمَلَاتِ الرَّقْمِيَّةِ.
     ح. الإِعْلَانُ عَنْ قَرَارَاتِهَا بِشَفَافِيَّةٍ.
     ط. تَلْقِي الآرَاءِ وَالمُقْتَرَحَاتِ مِنَ المُجْتَمَعِ.
     ي. إِصْدَارُ تَقْرِيرٍ سَنَوِيٍّ عَنْ حَالَةِ الشَّرِيعَةِ فِي الشَّبَكَةِ.)
  
  قُلْ "مَبَادِئُ_الرِّقَابَةِ" = 
    (١. المُوَافَقَةُ مَعَ القُرْآنِ وَالسُّنَّةِ أَصْلٌ مُقَدَّمٌ.
     ٢. العَدْلُ أَسَاسُ كُلِّ حُكْمٍ.
     ٣. الرَّحْمَةُ سِمَةٌ لِجَمِيعِ الفَتَاوَى.
     ٤. الشَّفَافِيَّةُ فِي القَرَارَاتِ وَاجِبَةٌ.
     ٥. المَشُورَةُ بَيْنَ أَعْضَاءِ اللَّجْنَةِ أَصْلٌ.
     ٦. التَّطَوُّرُ المَعْرِفِيُّ بِمَا يَتَعَلَّقُ بِالمُعَامَلَاتِ الرَّقْمِيَّةِ.
     ٧. عَدَمُ التَّعَصُّبِ لِرَأْيٍ مُعَيَّنٍ.
     ٨. التَّأْكِيدُ عَلَى ضَرُورَةِ إِخْرَاجِ الزَّكَاةِ.
     ٩. تَشْجِيعُ الصَّدَقَةِ وَالْوَقْفِ.
     ١٠. تَأْكِيدُ حُرِّيَّةِ التَّعَاقُدِ فِي حُدُودِ الشَّرْعِ.)
  
  # ============================================================
  # ٧. تَعْرِيفُ نَمَاذِجِ المُعَامَلَاتِ التَّطْبِيقِيَّةِ (يُوزْ كَيْسْزْ)
  # ============================================================
  
  قُلْ "نَمُوذَجُ_البَيْعِ" = 
    (يَرْغَبُ أَحْمَدُ فِي شِرَاءِ سَيَّارَةٍ مِنْ خَالِدٍ بِـ ١٠٠٠٠ دِينَارٍ إِسْلَامِيٍّ.
     يَقُومَانِ بِالتَّالِي:
     - يُنْشِئَانِ عَقْدَ بَيْعٍ فِي الشَّبَكَةِ.
     - يُحَدِّدَانِ السَّيَّارَةَ (بِمُوَاصَفَاتِهَا) وَالثَّمَنَ.
     - يُوَقِّعَانِ العَقْدَ بِمِفَاتِيحِهِمَا.
     - يُنَفَّذُ العَقْدُ بِتَحْوِيلِ ١٠٠٠٠ دِينَارٍ مِنْ أَحْمَدَ إِلَى خَالِدٍ.
     - يُثَبَّتُ العَقْدُ فِي الدَّفْتَرِ الأَسْتَرِيِّ.
     - يَسْتَلِمُ أَحْمَدُ السَّيَّارَةَ (فِي الوَاقِعِ).
     - يَضْمَنُ العَقْدُ حَقَّ المُشْتَرِي وَالبَائِعِ.)
  
  قُلْ "نَمُوذَجُ_المُضَارَبَةِ" = 
    (يَرْغَبُ عُمَرُ فِي اسْتِثْمَارِ ٥٠٠٠٠ دِينَارٍ عِنْدَ سُفْيَانَ بِمُضَارَبَةٍ،
     وَنِسْبَةُ الرِّبْحِ هِيَ ٥٠٪ لِعُمَرَ وَ ٥٠٪ لِسُفْيَانَ.
     يُنْشِئَانِ عَقْدَ المُضَارَبَةِ:
     - يُحَوِّلُ عُمَرُ ٥٠٠٠٠ دِينَارٍ إِلَى المُحَافَظَةِ المُشْتَرَكَةِ.
     - يَسْتَثْمِرُ سُفْيَانُ المَالَ فِي عَمَلِيَّاتٍ تِجَارِيَّةٍ حَلَالَةٍ.
     - يَتَمُّ حِسَابُ الرِّبْحِ فِي نِهَايَةِ الفَتْرَةِ.
     - تُوزَّعُ الأَرْبَاحُ بِنِسْبَةِ ٥٠-٥٠.
     - تُسَجَّلُ العَمَلِيَّةُ كَامِلَةً فِي الدَّفْتَرِ.)
  
  قُلْ "نَمُوذَجُ_الزَّكَاةِ" = 
    (حَانَ مَوْعِدُ إِخْرَاجِ زَكَاةِ فَاطِمَةَ.
     تَفْتَحُ تَطْبِيقَ المُحَافَظَةِ،
     تَضْغَطُ عَلَى "حِسَابُ الزَّكَاةِ"،
     يَظْهَرُ المِقْدَارُ المُسْتَحَقُّ (٢.٥٪ مِنَ الرَّصِيدِ).
     تَضْغَطُ عَلَى "إِخْرَاجُ الزَّكَاةِ"،
     تُحَوَّلُ الزَّكَاةُ إِلَى صُنْدُوقِ الزَّكَاةِ.
     تُسَجَّلُ المُعَامَلَةُ، وَتُوزَّعُ عَلَى المُسْتَحِقِّينَ آَلِيًّا.)
  
  قُلْ "نَمُوذَجُ_الْوَقْفِ" = 
    (يُرِيدُ عَلِيٌّ إِنْشَاءَ وَقْفٍ لِلْيَتَامَى.
     يُحَدِّدُ المَبْلَغَ (١٠٠٠٠ دِينَارٍ)،
     يُحَدِّدُ المُسْتَفِيدِينَ (الْيَتَامَى فِي مَدْرَسَتِهِمْ).
     يُنْشِئُ عَقْدَ الوَقْفِ.
     يُوقِعُ العَقْدَ بِمِفْتَاحِهِ.
     يُحَوِّلُ ١٠٠٠٠ دِينَارٍ إِلَى عَقْدِ الوَقْفِ.
     يُوَزَّعُ عَائِدُ الوَقْفِ آَلِيًّا عَلَى اليَتَامَى كُلَّ شَهْرٍ.
     يُسَجَّلُ الوَقْفُ فِي الدَّفْتَرِ وَيَكُونُ دَائِمًا.)
  
