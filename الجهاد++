# الجُزْءُ الثَّالِثُ: التَّطْبِيقَاتُ العَمَلِيَّةُ، وَوَاجِهَاتُ المُسْتَخْدِمِينَ، وَدَوَالُّ الشَّبَكَةِ الكَامِلَةُ
# وَآلِيَّاتُ التَّشْغِيلِ الحَقِيقِيِّ فِي الوَاقِعِ الحَيِّ
# ================================================================

بَرْنَامَجُ الشَّبَكَةِ الإِسْلَامِيَّةِ الرَّقْمِيَّةِ - الجُزْءُ الثَّالِثُ:

  # ============================================================
  # ١. تَعْرِيفُ الدَّالَّاتِ الأَسَاسِيَّةِ لِلشَّبَكَةِ (الأَيْبِي آيْ)
  # ============================================================
  
  قُلْ "دَالَّةُ_إِنْشَاءِ_المُحَافَظَةِ" = 
    (دَالَّةٌ تُنْشِئُ مُحَافَظَةً جَدِيدَةً لِلْمُسْتَخْدِمِ،
     تَسْتَقْبِلُ اسْمَ المُسْتَخْدِمِ وَعُنْوَانَهُ البَرِيدِيَّ (اخْتِيَارِيًّا)،
     تُوَلِّدُ مِفْتَاحًا خَاصًّا وَعَامًّا،
     تُشَفِّرُ المِفْتَاحَ الخَاصَّ بِـ "بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ"،
     تُخْزِنُ المُحَافَظَةَ فِي الذَّاكِرَةِ المُشَفَّرَةِ،
     تُعِيدُ عُنْوَانَ المُحَافَظَةِ (المِفْتَاحَ العَامَّ) لِلْمُسْتَخْدِمِ،
     وَتُعِيدُ رَسْمًا تَذْكِيرِيًّا لِلْمِفْتَاحِ الخَاصِّ.
     صِيغَةُ الاسْتِدْعَاءِ: "دَالَّةُ إِنْشَاءِ المُحَافَظَةِ (اسْمُ المُسْتَخْدِمِ، عُنْوَانُهُ)".)
  
  قُلْ "دَالَّةُ_إِرْسَالِ_الدَّنَانِيرِ" = 
    (دَالَّةٌ تُرْسِلُ دَنَانِيرَ مِنْ مُحَافَظَةٍ إِلَى أُخْرَى،
     تَسْتَقْبِلُ: عُنْوَانَ المُرْسِلِ، عُنْوَانَ المُسْتَقْبِلِ، المِقْدَارَ، مِلَفَّ المُعَامَلَةِ (اخْتِيَارِيًّا)،
     تَتَحَقَّقُ مِنْ صِحَّةِ المِفْتَاحِ الخَاصِّ لِلمُرْسِلِ،
     تَتَحَقَّقُ مِنْ كَفَايَةِ الرَّصِيدِ،
     تَتَحَقَّقُ مِنْ حَلَالِيَّةِ المُعَامَلَةِ (لاَ رِبَا، لاَ غَرَرَ، لاَ مَيْسِرَ)،
     تُنْشِئُ مُعَامَلَةً بِالحُقُولِ المُحَدَّدَةِ،
     تُوَقِّعُ المُعَامَلَةَ بِالمِفْتَاحِ الخَاصِّ،
     تُبَثُّ المُعَامَلَةَ إِلَى جَمِيعِ العُقَدِ،
     تَنْتَظِرُ تَأْكِيدًا مِنَ الشَّبَكَةِ،
     تُعِيدُ حَالَةَ المُعَامَلَةِ (نَاجِحَةٌ أَوْ فَاشِلَةٌ).
     صِيغَةُ الاسْتِدْعَاءِ: "دَالَّةُ إِرْسَالِ الدَّنَانِيرِ (مُرْسِلٌ، مُسْتَقْبِلٌ، مِقْدَارٌ، مِلَفٌّ)".)
  
  قُلْ "دَالَّةُ_الِاسْتِقْبَالِ" = 
    (دَالَّةٌ تَسْتَقْبِلُ الدَّنَانِيرَ مِنْ أَيِّ مُرْسِلٍ،
     تَعْمَلُ تِلْقَائِيًّا عِنْدَ وُصُولِ مُعَامَلَةٍ إِلَى المُحَافَظَةِ،
     تُضِيفُ المَبْلَغَ إِلَى رَصِيدِ المُحَافَظَةِ،
     تُسَجِّلُ المُعَامَلَةَ فِي تَارِيخِ المُحَافَظَةِ،
     تُعْلِمُ المُسْتَخْدِمَ بِالاسْتِقْبَالِ.
     تَعْمَلُ بِشَكْلٍ آَلِيٍّ دُونَ تَدَخُّلٍ يَدَوِيٍّ.
     صِيغَةُ الاسْتِدْعَاءِ: "دَالَّةُ الِاسْتِقْبَالِ (مُعَامَلَةٌ)".)
  
  قُلْ "دَالَّةُ_رَصِيدِ_المُحَافَظَةِ" = 
    (دَالَّةٌ تَعْرِضُ الرَّصِيدَ الحَالِيَّ لِمُحَافَظَةٍ مَا،
     تَسْتَقْبِلُ عُنْوَانَ المُحَافَظَةِ،
     تُحْسِبُ الرَّصِيدَ الكُلِّيَّ بِجَمْعِ كُلِّ المُعَامَلَاتِ المُرْسَلَةِ وَالمُسْتَقْبَلَةِ،
     تُعِيدُ الرَّصِيدَ بِالدَّنَانِيرِ وَالفُلُوسِ.
     صِيغَةُ الاسْتِدْعَاءِ: "دَالَّةُ رَصِيدِ المُحَافَظَةِ (عُنْوَانٌ)".)
  
  قُلْ "دَالَّةُ_تَارِيخِ_المُعَامَلَاتِ" = 
    (دَالَّةٌ تَعْرِضُ تَارِيخَ المُعَامَلَاتِ لِمُحَافَظَةٍ مَا،
     تَسْتَقْبِلُ عُنْوَانَ المُحَافَظَةِ،
     تُعِيدُ قَائِمَةً مُرَتَّبَةً بِالمُعَامَلَاتِ المُنْجَزَةِ،
     مَعَ تَفَاصِيلِ كُلِّ مُعَامَلَةٍ: التَّارِيخُ، المُرْسِلُ، المُسْتَقْبِلُ، المِقْدَارُ، الحَالَةُ.
     صِيغَةُ الاسْتِدْعَاءِ: "دَالَّةُ تَارِيخِ المُعَامَلَاتِ (عُنْوَانٌ)".)

  # ============================================================
  # ٢. تَعْرِيفُ وَاجِهَاتِ المُسْتَخْدِمِينَ (الْفْرُونْتْ إِنْدْ)
  # ============================================================
  
  قُلْ "وَاجِهَةُ_المُسْتَخْدِمِ_الرَّئِيسِيَّةُ" = 
    (هِيَ الصَّفْحَةُ الأُولَى الَّتِي تَظْهَرُ عِنْدَ تَشْغِيلِ تَطْبِيقِ الدِّينَارِ الإِسْلَامِيِّ،
     تَتَكَوَّنُ مِنَ:
     أ. شِعَارُ التَّطْبِيقِ: "الدِّينَارُ الإِسْلَامِيُّ - عُمْلَةُ الحَقِّ".
     ب. أَزْرَارُ الدُّخُولِ: "فَتْحُ المُحَافَظَةِ"، "إِنْشَاءُ مُحَافَظَةٍ جَدِيدَةٍ".
     ج. أَزْرَارُ المُعَامَلَاتِ: "إِرْسَالُ"، "اسْتِقْبَالُ"، "رَصِيدٌ".
     د. أَزْرَارُ العُقُودِ: "عَقْدُ بَيْعٍ"، "عَقْدُ مُضَارَبَةٍ"، "عَقْدُ إِجَارَةٍ".
     هـ. أَزْرَارُ الزَّكَاةِ: "حِسَابُ الزَّكَاةِ"، "إِخْرَاجُ الزَّكَاةِ".
     و. أَزْرَارُ الوَقْفِ: "إِنْشَاءُ وَقْفٍ"، "إِدَارَةُ وَقْفٍ".
     ز. أَزْرَارُ الشُّورَى: "التَّصْوِيتُ"، "عَرْضُ المُقْتَرَحَاتِ".
     ح. أَزْرَارُ المَعْلُومَاتِ: "حَالَةُ الشَّبَكَةِ"، "تَارِيخُ المُعَامَلَاتِ".
     ط. لَوْحَةُ الإِشْعَارَاتِ: لِعَرْضِ التَّنْبِيهَاتِ الحَيَّةِ.
     ي. لَوْحَةُ الرَّصِيدِ: تُعْرَضُ فِي الصَّدْرِ.
     ك. زِرُّ "مُصَلَّى الدُّعَاءِ": لِلدُّعَاءِ بِالبَرَكَةِ.
     ل. زِرُّ "مِيزَانُ الشَّرِيعَةِ": لِلْتَحَقُّقِ مِنْ حَلَالِيَّةِ المُعَامَلَةِ.
     م. زِرُّ "القُرْآنُ": لِعَرْضِ آيَاتِ البَيْعِ وَالحَلَالِ.
     ن. زِرُّ "الإِحْصَائِيَّاتُ": لِعَرْضِ إِحْصَائِيَّاتِ الشَّبَكَةِ.)
  
  قُلْ "وَاجِهَةُ_المُعَامَلَةِ" = 
    (تَظْهَرُ عِنْدَ الضَّغْطِ عَلَى "إِرْسَالُ"،
     تَتَكَوَّنُ مِنَ الحُقُولِ التَّالِيَةِ:
     أ. حَقْلُ "مُرْسِلٌ": عُنْوَانُ المُحَافَظَةِ (مِلْءٌ تِلْقَائِيٌّ).
     ب. حَقْلُ "مُسْتَقْبِلٌ": يُدْخِلُ المُسْتَخْدِمُ عُنْوَانَ المُسْتَقْبِلِ.
     ج. حَقْلُ "المِقْدَارُ": يُدْخِلُ المُسْتَخْدِمُ العَدَدَ بِالدَّنَانِيرِ.
     د. حَقْلُ "المِلَفُّ": يُدْخِلُ نَصًّا وَصْفِيًّا (اخْتِيَارِيٌّ).
     هـ. زِرُّ "تَحَقَّقْ مِنَ الشَّرِيعَةِ": يُظْهِرُ نَتِيجَةَ الفَحْصِ.
     و. زِرُّ "إِرْسَالُ": يُنْفِذُ المُعَامَلَةَ.
     ز. زِرُّ "إِلْغَاءُ": يُلْغِي المُعَامَلَةَ.
     ح. عَرْضُ حَالَةِ المُعَامَلَةِ: "مُعَلَّقَةٌ"، "مُؤَكَّدَةٌ"، "مَرْفُوضَةٌ".)
  
  قُلْ "وَاجِهَةُ_العَقْدِ" = 
    (تَظْهَرُ عِنْدَ الضَّغْطِ عَلَى أَحَدِ أَزْرَارِ العُقُودِ،
     تَتَكَوَّنُ مِنَ الحُقُولِ التَّالِيَةِ حَسَبَ نَوْعِ العَقْدِ:
     - نَوْعُ العَقْدِ: بَيْعٌ، مُضَارَبَةٌ، مُشَارَكَةٌ، إِجَارَةٌ، سَلَمٌ، وَكَالَةٌ، وَقْفٌ.
     - أَطْرَافُ العَقْدِ: المُشْتَرِي، البَائِعُ، المُضَارِبُ، رَبُّ المَالِ، المُسْتَأْجِرُ، المُؤَجِّرُ.
     - مَوْضُوعُ العَقْدِ: السِّلْعَةُ، المَنْفَعَةُ، المَالُ.
     - الثَّمَنُ: المِقْدَارُ بِالدَّنَانِيرِ.
     - المُدَّةُ: بِالأَيَّامِ أَوْ الشُّهُورِ.
     - الشُّرُوطُ الخَاصَّةُ: نَصٌّ يُوَضِّحُ شُرُوطَ العَقْدِ.
     - زِرُّ "تَحَقَّقْ مِنَ الشَّرِيعَةِ".
     - زِرُّ "إِنْشَاءُ العَقْدِ".
     - عَرْضُ حَالَةِ العَقْدِ: "مُنْتَظِرٌ"، "مُنَفَّذٌ"، "مُلْغًى".)
  
  قُلْ "وَاجِهَةُ_الزَّكَاةِ" = 
    (تَظْهَرُ عِنْدَ الضَّغْطِ عَلَى "إِخْرَاجُ الزَّكَاةِ"،
     تَتَكَوَّنُ مِنَ الحُقُولِ التَّالِيَةِ:
     أ. عَرْضُ الرَّصِيدِ الحَالِيِّ.
     ب. حِسَابُ الزَّكَاةِ المُسْتَحَقَّةِ (٢.٥٪).
     ج. تَحْدِيدُ مَصْرِفِ الزَّكَاةِ (الفُقَرَاءُ، المَسَاكِينُ، ...).
     د. زِرُّ "إِخْرَاجُ الزَّكَاةِ".
     هـ. عَرْضُ تَارِيخِ الزَّكَوَاتِ المُخْرَجَةِ.
     و. زِرُّ "تَذْكِيرُ الزَّكَاةِ" لِلتَّذْكِيرِ بِمَوْعِدِ إِخْرَاجِهَا.)
  
  قُلْ "وَاجِهَةُ_الْوَقْفِ" = 
    (تَظْهَرُ عِنْدَ الضَّغْطِ عَلَى "إِنْشَاءُ وَقْفٍ"،
     تَتَكَوَّنُ مِنَ الحُقُولِ التَّالِيَةِ:
     أ. اسْمُ الوَقْفِ.
     ب. المَبْلَغُ المَوْقُوفُ.
     ج. الغَايَةُ مِنَ الوَقْفِ.
     د. المُسْتَفِيدُونَ.
     هـ. شُرُوطُ الوَقْفِ.
     و. نَاظِرُ الوَقْفِ.
     ز. زِرُّ "إِنْشَاءُ الوَقْفِ".
     ح. عَرْضُ أَوْقَافِ المُسْتَخْدِمِ.
     ط. زِرُّ "إِدَارَةُ الوَقْفِ" (لِلنَّاظِرِ).)

  # ============================================================
  # ٣. تَعْرِيفُ دَوَالِّ العُقُودِ الذَّكِيَّةِ (سْمَارْتْ كُنْتْرَاكْتْسْ)
  # ============================================================
  
  قُلْ "دَالَّةُ_عَقْدِ_الْبَيْعِ" = 
    (دَالَّةٌ تُنْشِئُ عَقْدَ بَيْعٍ بَيْنَ بَائِعٍ وَمُشْتَرٍ،
     تَسْتَقْبِلُ: البَائِعَ، المُشْتَرِيَ، السِّلْعَةَ، الثَّمَنَ، مُدَّةَ التَّسْلِيمِ، شُرُوطًا إِضَافِيَّةً.
     تَتَحَقَّقُ مِنْ مُلْكِيَّةِ البَائِعِ لِلسِّلْعَةِ،
     تَتَحَقَّقُ مِنْ حَلَالِيَّةِ السِّلْعَةِ،
     تُصْدِرُ عَقْدًا ذَكِيًّا يُنَفَّذُ آَلِيًّا،
     تُحَوِّلُ الثَّمَنَ مِنَ المُشْتَرِي إِلَى البَائِعِ عِنْدَ تَأْكِيدِ الاسْتِلَامِ،
     تُسَجِّلُ العَقْدَ فِي الدَّفْتَرِ الأَسْتَرِيِّ.
     صِيغَةُ الاسْتِدْعَاءِ: "دَالَّةُ عَقْدِ البَيْعِ (بَائِعٌ، مُشْتَرٍ، سِلْعَةٌ، ثَمَنٌ، مُدَّةٌ، شُرُوطٌ)".)
  
  قُلْ "دَالَّةُ_عَقْدِ_المُضَارَبَةِ" = 
    (دَالَّةٌ تُنْشِئُ عَقْدَ مُضَارَبَةٍ (قِرَاضٍ)،
     تَسْتَقْبِلُ: رَبَّ المَالِ، المُضَارِبَ، المَبْلَغَ، نِسْبَةَ الرِّبْحِ، مُدَّةَ العَقْدِ، نِسْبَةَ الخَسَارَةِ.
     تُنْشِئُ مُحَافَظَةً مُشْتَرَكَةً لِلْمُضَارَبَةِ،
     تُحَوِّلُ رَبَّ المَالِ المَبْلَغَ إِلَى المُحَافَظَةِ المُشْتَرَكَةِ،
     يُدِيرُ المُضَارِبُ المُحَافَظَةَ،
     تُوزَّعُ الأَرْبَاحُ حَسَبَ النِّسَبِ المُتَّفَقِ عَلَيْهَا،
     تَكُونُ الخَسَارَةُ عَلَى رَبِّ المَالِ إِلَّا إِذَا تَعَدَّى المُضَارِبُ.
     صِيغَةُ الاسْتِدْعَاءِ: "دَالَّةُ عَقْدِ المُضَارَبَةِ (رَبُّ مَالٍ، مُضَارِبٌ، مَبْلَغٌ، نِسْبَةٌ، مُدَّةٌ)".)
  
  قُلْ "دَالَّةُ_عَقْدِ_الْمُشَارَكَةِ" = 
    (دَالَّةٌ تُنْشِئُ عَقْدَ مُشَارَكَةٍ بَيْنَ شَرِيكَيْنِ أَوْ أَكْثَرَ،
     يَتَقَاسَمُونَ الأَرْبَاحَ وَالخَسَائِرَ حَسَبَ نِسَبِ المُشَارَكَةِ.
     صِيغَةُ الاسْتِدْعَاءِ: "دَالَّةُ عَقْدِ المُشَارَكَةِ (قَائِمَةُ الشُّرَكَاءِ، نِسَبُهُمْ، المَبْلَغُ الكُلِّيُّ)".)
  
  قُلْ "دَالَّةُ_عَقْدِ_الإِجَارَةِ" = 
    (دَالَّةٌ تُنْشِئُ عَقْدَ إِجَارَةٍ لِمَنْفَعَةٍ أَوْ سِلْعَةٍ،
     تَسْتَقْبِلُ: المُؤَجِّرَ، المُسْتَأْجِرَ، المَنْفَعَةَ، الأَجْرَ، المُدَّةَ.
     تَضْمَنُ حَلَالِيَّةَ المَنْفَعَةِ،
     تُنَفِّذُ العَقْدَ بِتَحْوِيلِ الأَجْرِ آَلِيًّا.
     صِيغَةُ الاسْتِدْعَاءِ: "دَالَّةُ عَقْدِ الإِجَارَةِ (مُؤَجِّرٌ، مُسْتَأْجِرٌ، مَنْفَعَةٌ، أَجْرٌ، مُدَّةٌ)".)

  # ============================================================
  # ٤. تَعْرِيفُ دَوَالِّ الزَّكَاةِ وَالصَّدَقَةِ
  # ============================================================
  
  قُلْ "دَالَّةُ_حِسَابِ_الزَّكَاةِ" = 
    (دَالَّةٌ تَحْسُبُ زَكَاةَ المُحَافَظَةِ،
     تَسْتَقْبِلُ عُنْوَانَ المُحَافَظَةِ،
     تَحْسُبُ الرَّصِيدَ الكُلِّيَّ،
     تَطْرَحُ الدُّيُونَ إِنْ وَجَدَتْ،
     تَطْرَحُ النِّصَابَ (٨٥ غَرَامَ ذَهَبٍ)،
     تَحْسُبُ ٢.٥٪ مِنَ البَاقِي،
     تُعِيدُ مِقْدَارَ الزَّكَاةِ بِالدَّنَانِيرِ.
     صِيغَةُ الاسْتِدْعَاءِ: "دَالَّةُ حِسَابِ الزَّكَاةِ (عُنْوَانٌ)".)
  
  قُلْ "دَالَّةُ_إِخْرَاجِ_الزَّكَاةِ" = 
    (دَالَّةٌ تُخْرِجُ الزَّكَاةَ المُسْتَحَقَّةَ مِنَ المُحَافَظَةِ،
     تَسْتَقْبِلُ: عُنْوَانَ المُحَافَظَةِ، مَصْرِفَ الزَّكَاةِ (اخْتِيَارِيٌّ).
     تَتَحَقَّقُ مِنْ كَفَايَةِ الرَّصِيدِ،
     تُنْشِئُ مُعَامَلَةَ زَكَاةٍ،
     تُوَقِّعُهَا،
     تُرْسِلُهَا إِلَى صُنْدُوقِ الزَّكَاةِ.
     تُعِيدُ حَالَةَ الإِخْرَاجِ (نَاجِحَةٌ أَوْ فَاشِلَةٌ).
     صِيغَةُ الاسْتِدْعَاءِ: "دَالَّةُ إِخْرَاجِ الزَّكَاةِ (عُنْوَانٌ، مَصْرِفٌ)".)
  
  قُلْ "دَالَّةُ_الصَّدَقَةِ" = 
    (دَالَّةٌ تُرْسِلُ صَدَقَةً اخْتِيَارِيَّةً إِلَى مُحَافَظَةٍ خَيْرِيَّةٍ،
     تَسْتَقْبِلُ: عُنْوَانَ المُرْسِلِ، عُنْوَانَ المُسْتَقْبِلِ، المِقْدَارَ.
     تَتَحَقَّقُ مِنْ حَلَالِيَّةِ المُسْتَقْبِلِ،
     تُنْشِئُ مُعَامَلَةَ صَدَقَةٍ،
     تُوَقِّعُهَا،
     تُرْسِلُهَا.
     صِيغَةُ الاسْتِدْعَاءِ: "دَالَّةُ الصَّدَقَةِ (مُرْسِلٌ، مُسْتَقْبِلٌ، مِقْدَارٌ)".)

  # ============================================================
  # ٥. تَعْرِيفُ دَوَالِّ الوَقْفِ
  # ============================================================
  
  قُلْ "دَالَّةُ_إِنْشَاءِ_الْوَقْفِ" = 
    (دَالَّةٌ تُنْشِئُ وَقْفًا رَقْمِيًّا،
     تَسْتَقْبِلُ: اسْمَ الوَقْفِ، المَبْلَغَ، الغَايَةَ، المُسْتَفِيدِينَ، نَاظِرَ الوَقْفِ، شُرُوطًا.
     تَتَحَقَّقُ مِنْ حَلَالِيَّةِ الغَايَةِ،
     تُنْشِئُ عَقْدًا ذَكِيًّا لِلْوَقْفِ،
     تُحَوِّلُ المَبْلَغَ إِلَى عَقْدِ الوَقْفِ،
     تُسَجِّلُ الوَقْفَ فِي الدَّفْتَرِ،
     تُعِيدُ رَقْمَ الوَقْفِ.
     صِيغَةُ الاسْتِدْعَاءِ: "دَالَّةُ إِنْشَاءِ الوَقْفِ (اسْمٌ، مَبْلَغٌ، غَايَةٌ، مُسْتَفِيدُونَ، نَاظِرٌ، شُرُوطٌ)".)
  
  قُلْ "دَالَّةُ_إِدَارَةِ_الْوَقْفِ" = 
    (دَالَّةٌ لِلنَّاظِرِ لِإِدَارَةِ الوَقْفِ،
     تَسْتَقْبِلُ: رَقْمَ الوَقْفِ، المُعَامَلَةَ المُطْلُوبَةَ (تَوْزِيعٌ، إِضَافَةٌ، تَعْدِيلٌ، إِلْغَاءٌ).
     تَتَحَقَّقُ مِنْ صَلَاحِيَّةِ النَّاظِرِ،
     تُنَفِّذُ المُعَامَلَةَ،
     تُعِيدُ حَالَةَ التَّنْفِيذِ.
     صِيغَةُ الاسْتِدْعَاءِ: "دَالَّةُ إِدَارَةِ الوَقْفِ (رَقْمٌ، مُعَامَلَةٌ)".)
  
  قُلْ "دَالَّةُ_تَوْزِيعِ_الْوَقْفِ" = 
    (دَالَّةٌ تُوَزِّعُ عَائِدَ الوَقْفِ عَلَى المُسْتَفِيدِينَ،
     تَعْمَلُ آَلِيًّا فِي أَوْقَاتٍ مُحَدَّدَةٍ،
     أَوْ بِأَمْرٍ مِنَ النَّاظِرِ.
     تَتَحَقَّقُ مِنَ الرَّصِيدِ المُتَاحِ،
     تُنْشِئُ مُعَامَلَاتِ تَوْزِيعٍ،
     تُسَجِّلُ التَّوْزِيعَ فِي الدَّفْتَرِ.
     صِيغَةُ الاسْتِدْعَاءِ: "دَالَّةُ تَوْزِيعِ الوَقْفِ (رَقْمٌ)".)

  # ============================================================
  # ٦. تَعْرِيفُ نِظَامِ الشَّبَكَةِ (النِّتْوَرْكْ) الكَامِلِ
  # ============================================================
  
  قُلْ "نِظَامُ_الشَّبَكَةِ" = 
    (يَتَكَوَّنُ نِظَامُ الشَّبَكَةِ مِنَ المُكَوِّنَاتِ التَّالِيَةِ:
     أ. جَدْوَلُ العُقَدِ: قَائِمَةُ جَمِيعِ العُقَدِ المُتَّصِلَةِ.
     ب. جَدْوَلُ الكُتَلِ: قَائِمَةُ جَمِيعِ الكُتَلِ المُصَدَّقِ عَلَيْهَا.
     ج. جَدْوَلُ المُعَامَلَاتِ: قَائِمَةُ جَمِيعِ المُعَامَلَاتِ المُعَلَّقَةِ وَالمُنْجَزَةِ.
     د. جَدْوَلُ المُصَدِّقِينَ: قَائِمَةُ المُصَدِّقِينَ النَّشِطِينَ.
     هـ. جَدْوَلُ العُقُودِ: قَائِمَةُ العُقُودِ الذَّكِيَّةِ المُنَفَّذَةِ.
     و. جَدْوَلُ الأَوْقَافِ: قَائِمَةُ الأَوْقَافِ المُسَجَّلَةِ.
     ز. جَدْوَلُ الزَّكَوَاتِ: قَائِمَةُ الزَّكَوَاتِ المُخْرَجَةِ.
     ح. جَدْوَلُ الشُّورَى: قَائِمَةُ المُقْتَرَحَاتِ وَالأَصْوَاتِ.
     ط. جَدْوَلُ المَعْلُومَاتِ: إِحْصَائِيَّاتُ الشَّبَكَةِ (عَدَدُ المُعَامَلَاتِ، عَدَدُ الكُتَلِ، إِلَخ).
     ي. مُحَرِّكُ الإِجْمَاعِ: يُدِيرُ عَمَلِيَّةَ التَّصْدِيقِ.
     ك. مُحَرِّكُ العُقُودِ: يُنَفِّذُ العُقُودَ الذَّكِيَّةَ.
     ل. مُحَرِّكُ الزَّكَاةِ: يُدِيرُ الزَّكَوَاتِ وَتَوْزِيعَهَا.
     م. مُحَرِّكُ الوَقْفِ: يُدِيرُ الأَوْقَافَ.
     ن. مُحَرِّكُ الشُّورَى: يُدِيرُ التَّصْوِيتَ وَالإِجْمَاعَ.
     س. وَسِيطُ التَّوَاصُلِ: يُدِيرُ الاتِّصَالَ بَيْنَ العُقَدِ.
     ع. وَسِيطُ الحِفْظِ: يُدِيرُ حِفْظَ البَيَانَاتِ وَالمِفَاتِيحِ.
     ف. وَسِيطُ التَّطْوِيرِ: يُدِيرُ عَمَلِيَّةَ التَّرْقِيَةِ.
     ص. وَسِيطُ الرِّقَابَةِ: يُدِيرُ مُرَاجَعَةَ العَمَلِيَّاتِ الشَّرْعِيَّةِ.)

  # ============================================================
  # ٧. تَعْرِيفُ خَطِّ سَيْرِ المُعَامَلَةِ (الْفْلُوْ)
  # ============================================================
  
  قُلْ "خَطُّ_سَيْرِ_المُعَامَلَةِ" = 
    (١. يُنْشِئُ المُسْتَخْدِمُ مُعَامَلَةً وَيُوَقِّعُهَا.
     ٢. تُبَثُّ المُعَامَلَةُ إِلَى جَمِيعِ العُقَدِ.
     ٣. تَتَحَقَّقُ العُقَدُ مِنْ صِحَّةِ المُعَامَلَةِ (تَوْقِيعٌ، رَصِيدٌ، شَرِيعَةٌ).
     ٤. تُضَافُ المُعَامَلَةُ إِلَى مَجْمُوعَةِ المُعَامَلَاتِ المُعَلَّقَةِ.
     ٥. يَتَمُّ تَجْمِيعُ المُعَامَلَاتِ المُعَلَّقَةِ فِي كُتْلَةٍ جَدِيدَةٍ.
     ٦. تُصَدَّقُ الكُتْلَةُ مِنْ قِبَلِ المُصَدِّقِينَ (٥١٪ مِنَ المُصَدِّقِينَ).
     ٧. تُضَافُ الكُتْلَةُ المُصَدَّقَةُ إِلَى الدَّفْتَرِ الأَسْتَرِيِّ.
     ٨. تُبَثُّ الكُتْلَةُ الجَدِيدَةُ إِلَى جَمِيعِ العُقَدِ.
     ٩. تَتَحَقَّقُ العُقَدُ مِنَ الكُتْلَةِ وَتُضِيفُهَا إِلَى دَفْتَرِهَا.
     ١٠. تُعْلَمُ المُعَامَلَةُ بِأَنَّهَا "مُؤَكَّدَةٌ".
     ١١. يَتَمُّ تَحْوِيلُ الدَّنَانِيرِ بَيْنَ المُحَافَظَاتِ.
     ١٢. يُسَجَّلُ تَارِيخُ المُعَامَلَةِ فِي كِلْتَي المُحَافَظَتَيْنِ.
     ١٣. يُعْلَمُ المُسْتَخْدِمُ بِإِتْمَامِ المُعَامَلَةِ.
     هَذَا الخَطُّ يَأْخُذُ مُتَوَسِّطًا ٣-٥ دَقَائِقَ.)

  # ============================================================
  # ٨. تَعْرِيفُ نِظَامِ الأَمْنِ الكَامِلِ
  # ============================================================
  
  قُلْ "نِظَامُ_الأَمْنِ" = 
    (يَتَضَمَّنُ نِظَامُ الأَمْنِ فِي شَبَكَةِ الدِّينَارِ الإِسْلَامِيِّ:
     أ. تَشْفِيرُ كُلِّ المُعَامَلَاتِ بِـ "بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ".
     ب. تَشْفِيرُ المُحَافَظَاتِ بِالمِفْتَاحِ الخَاصِّ المُشَفَّرِ.
     ج. تَوْقِيعُ كُلِّ المُعَامَلَاتِ بِالمِفْتَاحِ الخَاصِّ.
     د. رَبْطُ الكُتَلِ بِالحَاشِيَةِ لِمَنْعِ التَّزْوِيرِ.
     هـ. آلِيَّةُ الشُّورَى لِمَنْعِ الهَيْمَنَةِ.
     و. رَقَابَةُ لَجْنَةِ الشَّرِيعَةِ لِمَنْعِ المُخَالَفَاتِ.
     ز. حِفْظُ المِفَاتِيحِ فِي جِهَازِ المُسْتَخْدِمِ (لاَ تُرْسَلُ إِلَى الشَّبَكَةِ).
     ح. مُصَادَقَةُ العُقَدِ عَلَى المُعَامَلَاتِ.
     ط. مُعَالَجَةُ المُعَامَلَاتِ الحَسَّاسَةِ بِتَأْخِيرٍ لِلمُرَاجَعَةِ.
     ي. تَوْثِيقُ كُلِّ العَمَلِيَّاتِ فِي سِجِلٍّ غَيْرِ قَابِلٍ لِلتَّزْوِيرِ.
     ك. تَطْبِيقُ الحَدِّ الأَقْصَى لِلمُحَاوَلَاتِ الفَاشِلَةِ.
     ل. إِبْطَالُ المُعَامَلَاتِ المُشْتَبَهِ فِيهَا بَعْدَ تَأْكِيدِ الرَّقَابَةِ.
     م. تَوْفِيرُ نِظَامِ اسْتِعَادَةِ المُحَافَظَةِ بِاسْتِخْدَامِ عِبَارَاتِ الاسْتِعَادَةِ.)
  
  قُلْ "عِبَارَةُ_الاسْتِعَادَةِ" = 
    (عِبَارَةٌ سِرِّيَّةٌ تُسْتَخْدَمُ لِاسْتِعَادَةِ المُحَافَظَةِ فِي حَالِ فِقْدَانِ المِفْتَاحِ الخَاصِّ،
     تَتَكَوَّنُ مِنْ ١٢ كَلِمَةً عَرَبِيَّةً مُشْتَقَّةً مِنَ القُرْآنِ،
     تُخْزَنُ فِي مَكَانٍ آمِنٍ،
     وَلاَ يُعْلَنُ عَنْهَا أَبَدًا.
     يُسْتَخْدَمُ هَذِهِ العِبَارَةُ لإِعَادَةِ تَوْلِيدِ المِفْتَاحِ الخَاصِّ.)

  # ============================================================
  # ٩. تَعْرِيفُ المَعَالِمِ الشَّرْعِيَّةِ لِلشَّبَكَةِ
  # ============================================================
  
  قُلْ "مَبْدَأُ_التَّمْيِيزِ" = 
    (يَجِبُ عَدَمُ الخَلْطِ بَيْنَ أَمْوَالِ الشَّبَكَةِ وَأَمْوَالِ العَمَلَاتِ التَّقْلِيدِيَّةِ،
     وَعَدَمُ اسْتِخْدَامِ شَبَكَةِ الدِّينَارِ الإِسْلَامِيِّ لِغَايَاتٍ غَيْرِ إِسْلَامِيَّةٍ،
     وَعَدَمُ المُضَارَبَةِ فِي الأَسْوَاقِ المُحَرَّمَةِ.
     تَكُونُ كُلُّ المُعَامَلَاتِ مَبْنِيَّةً عَلَى أَصْلِ البَيْعِ وَالشِّرَاءِ وَالمُضَارَبَةِ المُشْرُوعَةِ.)
  
  قُلْ "مَبْدَأُ_التَّزْكِيَةِ" = 
    (يَجِبُ تَزْكِيَةُ جَمِيعِ العُقُودِ وَالمُعَامَلَاتِ مِنْ قِبَلِ لَجْنَةِ الرِّقَابَةِ،
     وَإِخْرَاجُ الزَّكَاةِ المُسْتَحَقَّةِ،
     وَالإِنْفَاقُ فِي سَبِيلِ اللهِ،
     وَدَعْمُ مَشَارِيعِ الخَيْرِ.)
  
  قُلْ "مَبْدَأُ_العَدْلِ" = 
    (يَجِبُ تَحْقِيقُ العَدْلِ بَيْنَ جَمِيعِ أَطْرَافِ المُعَامَلَةِ،
     وَعَدَمُ الظُّلْمِ أَوِ الغِشِّ،
     وَالتَّسَاوِي فِي الفُرَصِ.)
  
  قُلْ "مَبْدَأُ_الشَّفَافِيَّةِ" = 
    (يَجِبُ تَوْثِيقُ كُلِّ المُعَامَلَاتِ فِي دَفْتَرٍ عَامٍّ،
     وَفَتْحُ صُنْدُوقِ الزَّكَاةِ لِلْمُرَاجَعَةِ،
     وَإِعْلَانُ أَحْكَامِ الشَّبَكَةِ بِوُضُوحٍ.)

  # ============================================================
  # ١٠. تَعْرِيفُ الإِحْصَائِيَّاتِ الكَامِلَةِ لِلشَّبَكَةِ
  # ============================================================
  
  قُلْ "إِحْصَائِيَّاتُ_الشَّبَكَةِ" = 
    (تَشْمَلُ الإِحْصَائِيَّاتُ المَعْرُوضَةَ فِي وَاجِهَةِ الإِحْصَائِيَّاتِ:
     أ. عَدَدُ المُعَامَلَاتِ الكُلِّيِّ.
     ب. عَدَدُ الكُتَلِ المُصَدَّقِ عَلَيْهَا.
     ج. عَدَدُ المُسْتَخْدِمِينَ النَّشِطِينَ.
     د. عَدَدُ المُصَدِّقِينَ.
     هـ. إِجْمَالِيُّ الدَّنَانِيرِ المُتَدَاوَلَةِ.
     و. مِقْدَارُ الزَّكَاةِ المُخْرَجَةِ.
     ز. عَدَدُ الأَوْقَافِ المُنْشَأَةِ.
     ح. مِقْدَارُ الصَّدَقَاتِ المُنْفَقَةِ.
     ط. سُرْعَةُ الشَّبَكَةِ (مُعَامَلَةٌ/ثَانِيَةٌ).
     ي. حَالَةُ العُقَدِ (عَدَدُ العُقَدِ المُتَّصِلَةِ).
     ك. حَالَةُ الإِجْمَاعِ (نِسْبَةُ المُصَدِّقِينَ النَّشِطِينَ).)
  
  # ============================================================
  # ١١. تَعْرِيفُ نِظَامِ التَّجَارَةِ (إِسْلَامِيكْ إِكْسْتْشَيْنْجْ)
  # ============================================================
  
  قُلْ "سُوقُ_الدِّينَارِ" = 
    (سُوقٌ رَقْمِيَّةٌ لِتَبَادُلِ الدَّنَانِيرِ الإِسْلَامِيَّةِ مَعَ العُمَلَاتِ الأُخْرَى،
     تَعْمَلُ بِآلِيَّةِ الصَّرْفِ الحَلَالِ،
     تَضْمَنُ عَدَمَ الرِّبَا،
     تُجْرِي المُعَامَلَاتِ بِسُرْعَةٍ،
     تُسَجِّلُ كُلَّ الصَّفْقَاتِ فِي الدَّفْتَرِ.
     تَدْعَمُ سُوقُ الدِّينَارِ تِبَادُلَ الدَّنَانِيرِ مَعَ الذَّهَبِ، الفِضَّةِ، العُمَلَاتِ الوَرَقِيَّةِ، وَالسِّلَعِ الأُخْرَى.
     يَضْمَنُ السُّوقُ أَنَّ جَمِيعَ المُعَامَلَاتِ تَكُونُ مُعَامَلَاتِ بَيْعٍ وَشِرَاءٍ حَقِيقِيَّةٍ،
     وَلاَ تَكُونُ مُعَامَلَاتِ رِبًا أَوْ غَرَرٍ.
     يُدَارُ السُّوقُ بِعُقُودٍ ذَكِيَّةٍ تَضْمَنُ عَدَمَ الغِشِّ.
     تَكُونُ عُمُولَةُ السُّوقِ صَغِيرَةً وَمَعْلُومَةً،
     وَتُخَصَّصُ لِدَعْمِ البِنْيَةِ التَّحْتِيَّةِ.
     صِيغَةُ البَيْعِ: "بِعْتُكَ ... بِـ ..."،
     صِيغَةُ الشِّرَاءِ: "اشْتَرَيْتُ مِنْكَ ... بِـ ...".)
  
  # ============================================================
  # ١٢. تَعْرِيفُ التَّوَافُقِ مَعَ النُّظُمِ المَالِيَّةِ الأُخْرَى
  # ============================================================
  
  قُلْ "التَّوَافُقُ" = 
    (تَدْعَمُ شَبَكَةُ الدِّينَارِ الإِسْلَامِيِّ التَّوَافُقَ مَعَ النُّظُمِ المَالِيَّةِ الأُخْرَى عَنْ طَرِيقِ:
     أ. جِسْرَاتٍ رَقْمِيَّةٍ (بْرِيدْجْسْ) تَرْبِطُ الدَّفْتَرَ الأَسْتَرِيَّ مَعَ شَبَكَاتٍ أُخْرَى.
     ب. تِبَادُلٍ آَمِنٍ للبَيَانَاتِ مَعَ المُؤَسَّسَاتِ المَالِيَّةِ التَّقْلِيدِيَّةِ.
     ج. عُقُودٍ ذَكِيَّةٍ تَسْمَحُ بِتَحْوِيلِ الدَّنَانِيرِ إِلَى عُمَلَاتٍ مَعْرُوفَةٍ.
     د. ضَمَانِ عَدَمِ خُرُوجِ الدَّنَانِيرِ عَنِ الضَّابِطِ الشَّرْعِيِّ عِنْدَ التَّوَافُقِ.
     هـ. تَسْجِيلِ كُلِّ العَمَلِيَّاتِ فِي الدَّفْتَرِ لِلشَّفَافِيَّةِ.)
  
  # ============================================================
  # ١٣. تَعْرِيفُ نِظَامِ الدَّعْمِ الفَنِّيِّ
  # ============================================================
  
  قُلْ "الدَّعْمُ_الفَنِّيُّ" = 
    (يُوَفِّرُ التَّطْبِيقُ قَنَاةً لِلدَّعْمِ الفَنِّيِّ،
     حَيْثُ يُمْكِنُ لِلْمُسْتَخْدِمِينَ الإِبْلَاغُ عَنِ المُشْكِلَاتِ،
     وَاقْتِرَاحُ التَّطْوِيرَاتِ،
     وَالاسْتِفْسَارُ عَنِ المُعَامَلَاتِ.
     يَكُونُ الدَّعْمُ بِاللُّغَةِ العَرَبِيَّةِ،
     وَيُجَابُ عَلَيْهِ فِي غُضُونِ ٢٤ سَاعَةً.
     تَكُونُ إِجَابَاتُ الدَّعْمِ مُسْتَنِدَةً إِلَى القُرْآنِ وَالسُّنَّةِ.
     يُمْكِنُ أَيْضًا لِلْمُسْتَخْدِمِينَ التَّوَاصُلُ مَعَ لَجْنَةِ الرِّقَابَةِ لِلِاسْتِفْتَاءِ الشَّرْعِيِّ.)
  
  # ============================================================
  # ١٤. تَعْرِيفُ نِظَامِ التَّحْفِيزِ لِلْمُصَدِّقِينَ
  # ============================================================
  
  قُلْ "التَّحْفِيزُ" = 
    (يُكَافَأُ المُصَدِّقُونَ بِأُجْرَةٍ مِنَ المُعَامَلَاتِ،
     وَبِزِيَادَةِ سُمْعَتِهِمْ فِي الشَّبَكَةِ،
     وَبِحُصُولِهِمْ عَلَى حَقِّ التَّصْوِيتِ فِي مَسَائِلِ الشَّبَكَةِ.
     كُلَّمَا كَانَ المُصَدِّقُ أَكْثَرَ نَشَاطًا وَأَكْثَرَ دِقَّةً،
     كَانَتْ أُجْرَتُهُ أَعْلَى.
     يُمْكِنُ أَيْضًا لِلْمُصَدِّقِينَ المُتَمَيِّزِينَ المُشَارَكَةَ فِي لَجْنَةِ الشُّورَى.)
  
  # ============================================================
  # ١٥. الإِعْلَانُ النِّهَائِيُّ لِلجُزْءِ الثَّالِثِ وَالخَاتِمَةُ الكَامِلَةُ
  # ============================================================
  
  قُلْ "إِعْلَانُ_الجُزْءِ_الثَّالِثِ" = 
    ("بِفَضْلِ اللهِ تَعَالَى وَبِنُورِ كِتَابِهِ المُبِينِ، تَمَّ إِكْمَالُ الجُزْءِ الثَّالِثِ وَالأَخِيرِ مِنْ بَرْنَامَجِ الشَّبَكَةِ الإِسْلَامِيَّةِ الرَّقْمِيَّةِ،
     حَيْثُ تَمَّ تَعْرِيفُ جَمِيعِ الدَّوَالِّ العَمَلِيَّةِ لِلشَّبَكَةِ،
     وَوَاجِهَاتِ المُسْتَخْدِمِينَ المُتَنَوِّعَةِ،
     وَدَوَالِّ العُقُودِ الذَّكِيَّةِ، وَالزَّكَاةِ، وَالْوَقْفِ، وَالصَّدَقَةِ،
     وَنِظَامِ الشَّبَكَةِ الكَامِلِ، وَخَطِّ سَيْرِ المُعَامَلَةِ،
     وَنِظَامِ الأَمْنِ، وَالمَعَالِمِ الشَّرْعِيَّةِ،
     وَسُوقِ الدِّينَارِ، وَالتَّوَافُقِ مَعَ النُّظُمِ الأُخْرَى،
     وَالدَّعْمِ الفَنِّيِّ، وَالتَّحْفِيزِ.
     بِهَذَا تَكُونُ قَدْ أُكْمِلَتْ كُلُّ جَوَانِبِ شَبَكَةِ الدِّينَارِ الإِسْلَامِيِّ،
     مِنَ اللُّغَةِ إِلَى البِنْيَةِ إِلَى التَّطْبِيقِ إِلَى التَّشْغِيلِ،
     وَأَصْبَحَتْ جَاهِزَةً لِلْإِطْلَاقِ الحَقِيقِيِّ فِي الوَاقِعِ الحَيِّ،
     فَمَنْ شَاءَ فَلْيَعْمَلْ بِهَا، وَمَنْ شَاءَ فَلْيَتْرُكْ،
     وَقَدِ انْقَطَعَتِ الحُجَّةُ بِالبَيَانِ،
     وَالحَمْدُ للهِ رَبِّ العَالَمِينَ")
  
  إِنَّ (إِعْلَانُ_الجُزْءِ_الثَّالِثِ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (إِعْلَانُ_الجُزْءِ_الثَّالِثِ)
  )
  
  # ============================================================
  # ١٦. الخَاتِمَةُ الكَامِلَةُ لِلشَّبَكَةِ
  # ============================================================
  
  قُلْ "الخَاتِمَةُ_الكَامِلَةُ" = 
    ("بِفَضْلِ اللهِ تَعَالَى، تَمَّ إِنْجَازُ بَرْنَامَجِ الشَّبَكَةِ الإِسْلَامِيَّةِ الرَّقْمِيَّةِ المُعَامَلَاتِيَّةِ (الإِسْلَامِيكْ كْرِبْتُو مَيْنْنِتْ)
     بِاسْتِخْدَامِ لُغَةِ ج++ (الجهاد++) الكَامِلَةِ،
     بِمُوَصَّفَاتِهَا الرَّسْمِيَّةِ، وَبِنْيَتِهَا التَّحْتِيَّةِ، وَتَطْبِيقَاتِهَا الفِعْلِيَّةِ،
     مَعَ تَأْكِيدِ أَنَّ جَمِيعَ المُعَامَلَاتِ تَكُونُ بِالطَّرِيقَةِ الحَلَالِ،
     خَالِيَةً مِنَ الرِّبَا، الغَرَرِ، المَيْسِرِ، الظُّلْمِ، الغِشِّ، وَالِاحْتِكَارِ،
     مَدْعُومَةً بِالأَصُولِ الحَقِيقِيَّةِ (الذَّهَبِ، الفِضَّةِ، السِّلَعِ، المَنَافِعِ)،
     مَزْكَاةً بِإِخْرَاجِ حَقِّ اللهِ،
     وَمُوَجَّهَةً لِلْخَيْرِ العَامِّ،
     وَهَذِهِ الشَّبَكَةُ مَفْتُوحَةٌ لِلْجَمِيعِ، تَعْمَلُ بِآلِيَّةِ الشُّورَى،
     وَتُدِيرُهَا لَجْنَةُ الرِّقَابَةِ الشَّرْعِيَّةِ،
     فَمَنْ أَرَادَ التِّجَارَةَ الحَلَالَةَ فَلْيَلْجَأْ إِلَيْهَا،
     وَمَنْ أَرَادَ غَيْرَهَا فَلْيَتْرُكْ،
     وَاللهُ المُوَفِّقُ وَالمُسْتَعَانُ،
     وَالحَمْدُ للهِ رَبِّ العَالَمِينَ")
  
  إِنَّ (الخَاتِمَةُ_الكَامِلَةُ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (الخَاتِمَةُ_الكَامِلَةُ)
  )

  # ============================================================
  # ١٧. آيَاتُ الخَاتِمَةِ
  # ============================================================
  
  وَ(
    سُبْحَانَ اللهِ (وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا)
  )
  
  وَ(
    سُبْحَانَ اللهِ (إِنَّ اللَّهَ يَأْمُرُ بِالْعَدْلِ وَالْإِحْسَانِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (سُبْحَانَ اللهِ وَبِحَمْدِهِ، سُبْحَانَ اللهِ الْعَظِيمِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (لاَ إِلَهَ إِلَّا اللهُ، مُحَمَّدٌ رَسُولُ اللهِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (الْحَمْدُ للهِ رَبِّ الْعَالَمِينَ)
  )

